---
import type { CollectionEntry } from 'astro:content';
import { type Locale, localePath } from '../config';
import { blogTopics, topicOrder } from '../data/blog';
import { formatPostDate, readingMinutes } from '../lib/blog';
import Icon from './RuntimeIcon.astro';
import '../styles/blog.css';

interface Props { lang: Locale; posts: CollectionEntry<'blog'>[]; }
const { lang, posts } = Astro.props;
const copy = lang === 'zh'
  ? { eyebrow: '1flowbase 博客', title: '从一个真实问题开始构建。', description: '面向 AI 应用团队的实践指南：评估网关、组合模型、排查运行。每篇文章都给出适用边界和可继续验证的下一步。', paths: '你想先解决什么问题？', read: '阅读文章', empty: '文章正在准备中。', feed: '通过 RSS 订阅', count: '篇文章', minutes: '分钟阅读', docs: '查看全部文档' }
  : { eyebrow: '1flowbase Blog', title: 'Start with a real problem.', description: 'Practical guides for AI application teams: evaluate a gateway, compose models, and investigate a run. Each article includes its limits and a concrete next step to test.', paths: 'What are you working on?', read: 'Read article', empty: 'Articles are being prepared.', feed: 'Subscribe via RSS', count: 'articles', minutes: 'min read', docs: 'Browse all documentation' };
const topics = topicOrder.filter(topic => posts.some(post => post.data.topic === topic));
---
<section class="dark-panel blog-hero">
  <div class="site-container relative z-10">
    <span class="eyebrow">{copy.eyebrow}</span>
    <h1>{copy.title}</h1>
    <p>{copy.description}</p>
    <div class="blog-hero-links"><span>{posts.length} {copy.count}</span><a href="/rss.xml">{copy.feed}<Icon name="arrowUpRight" /></a><a href={localePath(lang, '/docs/')}>{copy.docs}<Icon name="arrow" /></a></div>
  </div>
</section>
<section class="blog-directory">
  <div class="site-container">
    {posts.length > 0 ? <>
      <h2 class="blog-path-heading">{copy.paths}</h2>
      <nav class="blog-paths" aria-label={copy.paths}>
        {topics.map((topic, index) => <a href={`#${topic}`} class="blog-path-card"><span class="blog-path-number">0{index + 1}</span><strong>{blogTopics[lang][topic].title}</strong><span>{blogTopics[lang][topic].description}</span><Icon name="arrow" /></a>)}
      </nav>
      {topics.map(topic => <section class="blog-topic" id={topic} aria-labelledby={`heading-${topic}`}>
        <div class="blog-topic-heading"><h2 id={`heading-${topic}`}>{blogTopics[lang][topic].title}</h2><a href={localePath(lang, `/docs/${blogTopics[lang][topic].guide ? `${blogTopics[lang][topic].guide}/` : ''}`)}>{blogTopics[lang][topic].next}<Icon name="arrow" /></a></div>
        <div class="blog-article-grid">{posts.filter(post => post.data.topic === topic).map(post => <article class="blog-article-card">
          <div class="blog-meta"><time datetime={post.data.publishedAt.toISOString()}>{formatPostDate(post.data.publishedAt, lang)}</time><span>·</span><span>{readingMinutes(post.body)} {copy.minutes}</span></div>
          <h3><a href={localePath(lang, `/blog/${post.data.slug}/`)}>{post.data.title}</a></h3>
          <p>{post.data.description}</p>
          <div class="blog-tags">{post.data.tags.map(tag => <span>{tag}</span>)}</div>
          <a class="blog-read-link" href={localePath(lang, `/blog/${post.data.slug}/`)} aria-label={`${copy.read}: ${post.data.title}`}>{copy.read}<Icon name="arrow" /></a>
        </article>)}</div>
      </section>)}
    </> : <p>{copy.empty}</p>}
  </div>
</section>

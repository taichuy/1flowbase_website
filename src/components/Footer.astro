---
import Logo from './Logo.astro';
import { SITE, type Locale, localePath } from '../config';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = lang === 'zh'
  ? {
      intro: '支持多人共享的开源企业 AI 应用基座，连接人与每一个 Super-agent。',
      product: '产品',
      resources: '资源',
      features: '应用模板',
      useCases: '使用场景',
      blog: '博客',
      docs: '文档',
      license: '许可协议',
      issues: 'Issues',
      source: '官网源码',
      rights: '开源、可自托管。',
    }
  : {
      intro: 'The open-source multi-user Enterprise Bot and AI app foundation connecting humans and Super-agents.',
      product: 'Product',
      resources: 'Resources',
      features: 'Features',
      useCases: 'Use cases',
      blog: 'Blog',
      docs: 'Documentation',
      license: 'License',
      issues: 'Issues',
      source: 'Website source',
      rights: 'Open source and self-hostable.',
    };
---

<footer class="relative overflow-hidden border-t border-line bg-white">
  <div class="site-container relative z-10 grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.8fr_1fr_1fr]">
    <div>
      <a href={localePath(lang)}><Logo /></a>
      <p class="mt-4 max-w-sm text-sm leading-7 text-muted">{copy.intro}</p>
    </div>
    <div>
      <h2 class="text-sm font-black text-ink">{copy.product}</h2>
      <ul class="mt-4 grid gap-3 text-sm text-muted">
        <li><a class="hover:text-emerald" href={localePath(lang, '/features/')}>{copy.features}</a></li>
        <li><a class="hover:text-emerald" href={localePath(lang, '/use-cases/')}>{copy.useCases}</a></li>
        <li><a class="hover:text-emerald" href={localePath(lang, '/blog/')}>{copy.blog}</a></li>
      </ul>
    </div>
    <div>
      <h2 class="text-sm font-black text-ink">{copy.resources}</h2>
      <ul class="mt-4 grid gap-3 text-sm text-muted">
        <li><a class="hover:text-emerald" href={localePath(lang, '/docs/')}>{copy.docs}</a></li>
        <li><a class="hover:text-emerald" href={localePath(lang, '/license/')}>{copy.license}</a></li>
        <li><a class="hover:text-emerald" href={SITE.issues}>{copy.issues}</a></li>
        <li><a class="hover:text-emerald" href={SITE.websiteRepository}>{copy.source}</a></li>
      </ul>
    </div>
  </div>
  <div class="site-container pointer-events-none select-none overflow-hidden pt-2 text-center" aria-hidden="true">
    <span class="block bg-gradient-to-b from-[#079667]/[0.07] to-[#0ea5e9]/[0.01] bg-clip-text text-[clamp(4.2rem,14vw,11.5rem)] font-black leading-[0.84] tracking-[-0.06em] text-transparent">
      1flowbase
    </span>
  </div>
  <div class="relative z-10 border-t border-line bg-white/90">
    <div class="site-container flex flex-col gap-2 py-5 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} 1flowbase. {copy.rights}</p>
      <p>{SITE.license} · Built with Astro</p>
    </div>
  </div>
</footer>

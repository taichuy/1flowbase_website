---
import Logo from './Logo.astro';
import DocsNavigation from './DocsNavigation.astro';
import '../styles/navigation.css';
import { SITE, type Locale, localePath } from '../config';

interface Props {
  lang: Locale;
  alternatePath?: string;
}

const { lang, alternatePath } = Astro.props;
const path = Astro.url.pathname;
const switchHref = alternatePath ?? (path.startsWith('/404')
  ? lang === 'zh' ? '/' : '/zh/'
  : lang === 'zh'
    ? path.replace(/^\/zh/, '') || '/'
    : `/zh${path === '/' ? '/' : path}`);

const labels = lang === 'zh'
  ? { nav: [['产品能力', '/features/'], ['使用场景', '/use-cases/'], ['博客', '/blog/']], docs: '文档', language: 'EN', menu: '打开导航', close: '关闭导航', navigation: '主导航', home: '1flowbase 首页', switchLanguage: 'Switch to English' }
  : { nav: [['Features', '/features/'], ['Use cases', '/use-cases/'], ['Blog', '/blog/']], docs: 'Docs', language: '中文', menu: 'Open navigation', close: 'Close navigation', navigation: 'Main navigation', home: '1flowbase home', switchLanguage: '切换到中文' };
---
<header class="site-header" data-site-header>
  <div class="site-container header-row">
    <a href={localePath(lang)} aria-label={labels.home}><Logo /></a>
    <nav class="desktop-navigation" aria-label={labels.navigation}>
      {labels.nav.map(([label, href]) => <a href={localePath(lang, href)} aria-current={path.startsWith(localePath(lang, href)) ? 'page' : undefined}>{label}</a>)}
      <div class="desktop-docs" data-disclosure>
        <button type="button" class="navigation-toggle" aria-expanded="false" aria-controls="desktop-docs-panel" data-disclosure-toggle>
          {labels.docs}<svg aria-hidden="true" viewBox="0 0 12 12"><path d="m2.5 4.5 3.5 3 3.5-3" /></svg>
        </button>
        <div id="desktop-docs-panel" class="desktop-docs-panel" hidden><DocsNavigation lang={lang} /></div>
      </div>
    </nav>
    <div class="header-actions">
      <a class="language-link" href={switchHref} aria-label={labels.switchLanguage} lang={lang === 'zh' ? 'en' : 'zh-CN'}>{labels.language}</a>
      <a class="github-link desktop-github" href={SITE.repository} target="_blank" rel="noreferrer">GitHub <span data-github-stars hidden>★ <span data-github-stars-value></span></span><svg aria-hidden="true" viewBox="0 0 16 16" class="navigation-arrow"><path d="M4 12 12 4M4 4h8v8" /></svg></a>
      <button type="button" class="mobile-menu-toggle" aria-expanded="false" aria-controls="mobile-navigation" aria-label={labels.menu} data-open-label={labels.menu} data-close-label={labels.close}>
        <svg aria-hidden="true" viewBox="0 0 24 24"><path class="menu-lines" d="M4 7h16M4 12h16M4 17h16"/><path class="menu-cross" d="m6 6 12 12M6 18 18 6"/></svg>
      </button>
    </div>
  </div>
  <div id="mobile-navigation" class="mobile-navigation" hidden>
    <nav class="site-container" aria-label={labels.navigation}>
      {labels.nav.map(([label, href]) => <a class="mobile-primary-link" href={localePath(lang, href)} aria-current={path.startsWith(localePath(lang, href)) ? 'page' : undefined}>{label}</a>)}
      <div class="mobile-docs" data-disclosure>
        <button type="button" class="navigation-toggle" aria-expanded="false" aria-controls="mobile-docs-panel" data-disclosure-toggle>{labels.docs}<svg aria-hidden="true" viewBox="0 0 12 12"><path d="m2.5 4.5 3.5 3 3.5-3" /></svg></button>
        <div id="mobile-docs-panel" hidden><DocsNavigation lang={lang} /></div>
      </div>
      <a class="github-link mobile-github" href={SITE.repository} target="_blank" rel="noreferrer">GitHub <span data-github-stars hidden>★ <span data-github-stars-value></span></span><svg aria-hidden="true" viewBox="0 0 16 16" class="navigation-arrow"><path d="M4 12 12 4M4 4h8v8" /></svg></a>
    </nav>
  </div>
    <nav class="navigation-fallback site-container flex flex-wrap gap-4 py-4 text-sm font-semibold" aria-label={labels.navigation}>
      {labels.nav.map(([label, href]) => <a href={localePath(lang, href)}>{label}</a>)}
      <a href={localePath(lang, '/docs/')}>{labels.docs}</a>
      <a href={SITE.repository}>GitHub</a>
    </nav>
</header>

<script>
  const starNodes = document.querySelectorAll('[data-github-stars-value]');
  const cacheKey = '1flowbase:github-stars';
  const renderStars = (count: number) => {
    const label = new Intl.NumberFormat(undefined, { notation: count >= 1000 ? 'compact' : 'standard', maximumFractionDigits: 1 }).format(count);
    starNodes.forEach((node) => { node.textContent = label; node.closest('[data-github-stars]')?.removeAttribute('hidden'); });
  };

  try {
    const cached = JSON.parse(localStorage.getItem(cacheKey) ?? 'null');
    if (cached?.count && Date.now() - cached.savedAt < 10 * 60 * 1000) renderStars(cached.count);

    fetch('https://api.github.com/repos/taichuy/1flowbase', { headers: { Accept: 'application/vnd.github+json' } })
      .then((response) => response.ok ? response.json() : Promise.reject(new Error('GitHub request failed')))
      .then((repository) => {
        if (typeof repository.stargazers_count !== 'number') return;
        renderStars(repository.stargazers_count);
        localStorage.setItem(cacheKey, JSON.stringify({ count: repository.stargazers_count, savedAt: Date.now() }));
      })
      .catch(() => {});
  } catch {
    // The GitHub link remains usable when storage or the public API is unavailable.
  }
</script>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]')!;
  const mobileToggle = header.querySelector<HTMLButtonElement>('.mobile-menu-toggle')!;
  const toggles = [...header.querySelectorAll<HTMLButtonElement>('[aria-controls]')];
  const setExpanded = (toggle: HTMLButtonElement, expanded: boolean) => {
    toggle.setAttribute('aria-expanded', String(expanded));
    document.getElementById(toggle.getAttribute('aria-controls')!)!.hidden = !expanded;
    if (toggle === mobileToggle) toggle.setAttribute('aria-label', expanded ? toggle.dataset.closeLabel! : toggle.dataset.openLabel!);
  };
  const closeAll = () => toggles.forEach(toggle => setExpanded(toggle, false));
  toggles.forEach(toggle => toggle.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') !== 'true';
    setExpanded(toggle, expanded);
    if (toggle === mobileToggle && !expanded) header.querySelectorAll<HTMLButtonElement>('[data-disclosure-toggle]').forEach(button => setExpanded(button, false));
  }));
  document.addEventListener('keydown', event => {
    if (event.key !== 'Escape') return;
    const open = toggles.filter(toggle => toggle.getAttribute('aria-expanded') === 'true');
    if (!open.length) return;
    // Close the nested disclosure first; another Escape closes mobile navigation.
    const toggle = open.find(button => button !== mobileToggle) ?? mobileToggle;
    setExpanded(toggle, false);
    toggle.focus();
    event.preventDefault();
  });
  document.addEventListener('click', event => {
    if (event.target instanceof Node && !header.contains(event.target)) closeAll();
  });
  header.addEventListener('focusout', event => {
    if (event.relatedTarget instanceof Node && !header.contains(event.relatedTarget)) closeAll();
  });
  header.querySelectorAll('a').forEach(link => link.addEventListener('click', closeAll));
  window.addEventListener('pageshow', closeAll);
  window.addEventListener('popstate', closeAll);
  window.matchMedia('(min-width: 960px)').addEventListener('change', () => {
    const activeToggle = toggles.find(toggle => toggle.getAttribute('aria-expanded') === 'true');
    closeAll();
    if (activeToggle && header.contains(document.activeElement)) header.querySelector<HTMLAnchorElement>('.language-link')?.focus();
  });
  header.setAttribute('data-navigation-ready', '');
</script>

---
import type { Locale } from '../config';
import Icon from './RuntimeIcon.astro';
import AssistantIcon from './AssistantIcon.astro';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const zh = lang === 'zh';
const chats = [
  { source:'Claude Code', time:'10:24', icon:'spark', tone:'claude', text:zh?'登录页已经完成，相关测试通过。':'The login page is finished and its tests are passing.' },
  { source:'Codex', time:'11:03', icon:'code', tone:'codex', text:zh?'支付回调还有一个失败用例，需要继续排查。':'One payment callback test still fails. More investigation is needed.' },
  { source:zh?'你':'You', time:'11:20', icon:'user', tone:'person', text:zh?'把发布文档列入下一步计划。':'Add the release documentation to the next steps.' },
];
const tasks = zh ? [
  ['登录页开发','已完成','done','Claude Code','11-06 10:24',0],
  ['支付回调异常','需处理','attention','Codex','11-06 11:03',1],
  ['发布文档','待开始','planned','你','11-06 11:20',2],
  ['用户反馈功能','进行中','planned','Claude Code','11-06 09:12',0],
  ['性能优化','待开始','planned','更多 Agent','11-06 08:45',3],
] : [
  ['Login page','Done','done','Claude Code','11-06 10:24',0],
  ['Payment callback','Needs attention','attention','Codex','11-06 11:03',1],
  ['Release docs','Not started','planned','You','11-06 11:20',2],
  ['User feedback','In progress','planned','Claude Code','11-06 09:12',0],
  ['Performance','Not started','planned','More agents','11-06 08:45',3],
];
const stats = zh ? [['已完成','12','done'],['需处理','3','attention'],['待开始','5','planned']] : [['Done','12','done'],['Needs attention','3','attention'],['Not started','5','planned']];
const tabNames = zh ? ['任务列表','进度趋势','数据来源'] : ['Task list','Progress','Sources'];
const uses = zh ? [['report','报表','从对话中提取业务数据'],['book','知识库','沉淀团队经验与知识'],['cube','业务工具','构建专属的工作应用']] : [['report','Reports','Extract useful data from conversations'],['book','Knowledge bases','Retain team experience and knowledge'],['cube','Business tools','Build applications for your work']];
---
<div class="conversation-demo" data-conversation-demo>
  <div class="demo-scene">
    <div class="chat-column">
      <p class="scene-note">{zh?'日常的工作对话…':'Everyday work conversations…'}<svg viewBox="0 0 40 35" aria-hidden="true"><path d="M6 2q-2 19 23 28m-9-1 9 1-2-9"/></svg></p>
      {chats.map((chat,i) => <article class="sample-chat" data-chat-example={i}><span class:list={['chat-avatar',chat.tone]}>{i<2?<AssistantIcon name={i===0?'claude':'chatgpt'}/>:<Icon name={chat.icon}/>}</span><div><header><strong>{chat.source}</strong><time>{chat.time}</time></header><p>{chat.text}{i===0&&<span class="chat-check" aria-hidden="true">✓</span>}</p></div></article>)}
      <div class="more-chat"><span class="chat-avatar muted">···</span><strong>{zh?'更多 Agent':'More agents'}</strong><Icon name="code"/><Icon name="spark"/><span aria-hidden="true">···</span></div>
    </div>
    <div class="scene-bridge">
      <svg class="chat-wires" viewBox="0 0 160 360" preserveAspectRatio="none" aria-hidden="true"><path d="M0 50C80 50 55 170 160 170M0 155C65 155 77 180 160 180M0 260C73 260 74 190 160 190M0 335C87 335 67 200 160 200"/></svg>
      <div class="demo-hub"><img src="/favicon.svg" alt="" width="50" height="50"/><strong>1flowbase</strong><span>{zh?'保存对话 · 构建应用':'Save conversations · build apps'}</span></div>
      <svg class="hub-arrow" viewBox="0 0 64 28" aria-hidden="true"><path d="M0 14h58m-10-9 10 9-10 9"/></svg>
    </div>
    <div class="report-column">
      <p class="scene-note output-note">{zh?'长出可持续使用的应用！':'Grow an application you can keep using!'}<svg viewBox="0 0 40 35" aria-hidden="true"><path d="M13 2q14 14 6 29m-5-7 5 7 7-6"/></svg></p>
      <section class="demo-report" aria-labelledby="sample-report-title">
        <div class="report-chrome" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="report-heading"><span class="report-avatar"><Icon name="report"/></span><div><h2 id="sample-report-title">{zh?'项目进展报表':'Project progress report'}</h2><p>{zh?'基于 Agent 对话数据 · 构建示例':'Built from agent conversations · sample data'}</p></div><span class="sample-date">11/01 — 11/07</span></div>
        <div class="report-stats">{stats.map(([label,count,tone])=><div class:list={['report-stat',tone]}><span class="stat-icon"><Icon name={tone==='done'?'check':tone==='attention'?'clock':'circle'}/></span><div><span>{label}</span><strong>{count}</strong></div></div>)}</div>
        <div class="report-navigation"><div role="tablist" aria-label={zh?'报表示例':'Report example'}>{tabNames.map((name,i)=><button type="button" role="tab" aria-selected={i===0?'true':'false'} aria-controls={`sample-report-panel-${i}`} id={`sample-report-tab-${i}`} tabindex={i===0?0:-1} data-demo-tab={i}>{name}</button>)}</div><button class="source-action" type="button" data-open-demo-source>{zh?'查看原始对话':'View conversation'}<Icon name="arrowUpRight"/></button></div>
        <div class="report-panel" id="sample-report-panel-0" role="tabpanel" aria-labelledby="sample-report-tab-0" data-demo-panel="0">
          <table><caption class="sr-only">{zh?'项目任务示例数据':'Example project tasks'}</caption><thead><tr>{(zh?['事项','状态','数据来源','更新时间']:['Task','Status','Source','Updated']).map(label=><th scope="col">{label}</th>)}</tr></thead><tbody>{tasks.map(([name,state,tone,source,time,index])=><tr><td>{name}</td><td><span class:list={['task-status',tone]}>{state}</span></td><td><span class:list={['source-name',index===0?'claude':index===1?'codex':index===2?'person':'muted']}>{index===0||index===1?<AssistantIcon name={index===0?'claude':'chatgpt'}/>:<Icon name={index===2?'user':'more'}/>}<span>{source}</span></span></td><td>{time}</td></tr>)}</tbody></table>
        </div>
        <div class="report-panel sample-progress" id="sample-report-panel-1" role="tabpanel" aria-labelledby="sample-report-tab-1" data-demo-panel="1" hidden><p>{zh?'任务状态概览 · 示例数据':'Task status overview · sample data'}</p>{stats.map(([label,count])=><div><span>{label}</span><meter min="0" max="20" value={count} aria-label={label}>{count}/20</meter><strong>{count}</strong></div>)}</div>
        <div class="report-panel sample-sources" id="sample-report-panel-2" role="tabpanel" aria-labelledby="sample-report-tab-2" data-demo-panel="2" hidden><p>{zh?'接入与记录范围由你配置。以下为示例对话。':'You configure client connections and what is recorded. These conversations are examples.'}</p>{chats.map(chat=><div><strong>{chat.source}</strong><span>{chat.text}</span></div>)}</div>
      </section>
    </div>
  </div>
  <div class="demo-uses">{uses.map(([icon,label,description])=><div><Icon name={icon}/><p><strong>{label}</strong><span>{description}</span></p></div>)}</div>
  <dialog class="sample-conversation" aria-labelledby="sample-conversation-title"><form method="dialog"><h2 id="sample-conversation-title">{zh?'原始对话 · 示例':'Original conversations · example'}</h2><button aria-label={zh?'关闭对话示例':'Close conversation example'}>×</button></form>{chats.map(chat=><article><strong>{chat.source}</strong><time>{chat.time}</time><p>{chat.text}</p></article>)}<p class="sample-notice">{zh?'演示内容，并未连接真实项目或私人会话。':'Demonstration content; not connected to a real project or private conversations.'}</p></dialog>
</div>
<style>
  .conversation-demo{width:100%;min-width:0;color:#173d33}.demo-scene{display:grid;grid-template-columns:minmax(0,1fr) minmax(210px,.94fr) minmax(0,1.75fr);align-items:center;position:relative;gap:0}.demo-scene:before{content:'';position:absolute;inset:12% 0 0;background:radial-gradient(ellipse at 40% 60%,#c9efd36b,transparent 60%);pointer-events:none}.chat-column,.report-column{position:relative;min-width:0}.sample-chat{position:relative;display:grid;grid-template-columns:32px minmax(0,1fr);gap:12px;margin-bottom:9px;padding:17px 16px;border:1px solid #e5ece5;background:#fffffff0;border-radius:17px;box-shadow:0 12px 32px #4d745506}.sample-chat header{display:flex;justify-content:space-between;gap:10px;align-items:center}.sample-chat strong{font-size:13px;color:#132c26}.sample-chat time{color:#84959c;font-size:11px}.sample-chat p{margin:9px 0 0;background:#f4f6f7;border-radius:9px;padding:9px 10px;font-size:13px;line-height:1.6;color:#283a37}.chat-avatar{display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;flex-shrink:0}.chat-avatar :global(svg){width:29px;height:29px}.claude{color:#cf734f}.codex{color:#18241f}.person{color:#1384e8;background:#e3f1ff;border-radius:50%}.muted{color:#9aa7a5}.chat-check{display:inline-block;background:#02ad60;color:#fff;border-radius:3px;padding:0 2px;margin-left:5px;font-size:11px;line-height:14px}.more-chat{display:flex;gap:13px;align-items:center;min-height:53px;padding:9px 16px;border:1px solid #e9eeea;background:#ffffffbd;border-radius:17px;color:#a7b2ae;font-size:12px}.more-chat strong{flex:1}.more-chat :global(svg){width:19px;height:19px;opacity:.5}.scene-note{position:absolute;left:-7px;bottom:calc(100% + 18px);margin:0;color:#72a191;font-size:17px;letter-spacing:.1em;font-family:cursive;transform:rotate(-7deg);white-space:nowrap;pointer-events:none}.scene-note svg{position:absolute;width:35px;height:35px;left:61%;top:100%;fill:none;stroke:currentColor;stroke-width:1.4}.output-note{left:auto;right:9px;color:#48a875;transform:rotate(-5deg);font-size:17px}.output-note svg{left:auto;right:10px}
  .scene-bridge{align-self:stretch;position:relative;display:flex;align-items:center;justify-content:flex-end;padding-right:47px;min-width:0}.chat-wires{position:absolute;inset:0 auto 0 0;width:62%;height:100%;fill:none;stroke:#add9bf;stroke-width:1.4}.demo-hub{position:relative;z-index:1;width:163px;min-height:153px;box-sizing:border-box;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:10px;background:#ffffffeb;border:1px solid #fff;border-radius:24px;padding:16px 10px;box-shadow:0 0 50px #ccefd185}.demo-hub strong{font-size:23px;letter-spacing:-.045em;font-weight:700}.demo-hub span{text-align:center;line-height:1.5;font-size:12px;color:#648077}.hub-arrow{position:absolute;width:48px;height:28px;right:0;top:calc(50% - 14px);fill:none;stroke:#91d6ab;stroke-width:2.4}
  .demo-report{position:relative;background:#ffffffef;border:1px solid #e4ece6;border-radius:18px;box-shadow:0 17px 50px #4472530b;overflow:hidden}.report-chrome{height:27px;border-bottom:1px solid #e8eeea;background:linear-gradient(#fff,#f5f8f7);display:flex;align-items:center;gap:7px;padding:0 13px}.report-chrome i{width:9px;height:9px;border-radius:50%;background:#ff9394}.report-chrome i:nth-child(2){background:#f5d574}.report-chrome i:nth-child(3){background:#80d691}.report-heading{display:flex;gap:9px;align-items:center;padding:14px 14px 10px}.report-avatar{width:37px;height:37px;display:grid;place-items:center;border-radius:13px;background:#e0f6ed;color:#09a177;flex-shrink:0}.report-avatar :global(svg){width:21px;height:21px}.report-heading>div{min-width:0;flex:1}.report-heading h2{font-size:16px;font-weight:650;line-height:1.3;margin:0 0 3px;letter-spacing:0}.report-heading p{font-size:10px;line-height:1.5;margin:0;color:#7c9195}.sample-date{font-size:10px;color:#557579;border:1px solid #e3eae7;border-radius:5px;padding:7px;white-space:nowrap}.report-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;padding:0 14px 13px}.report-stat{display:flex;gap:9px;align-items:center;border:1px solid #e1ebe7;border-radius:8px;min-height:58px;padding:9px;box-sizing:border-box}.stat-icon{width:30px;height:30px;display:grid;place-items:center;border-radius:50%;flex-shrink:0}.stat-icon :global(svg){width:19px;height:19px}.done .stat-icon{background:#e0f8ed;color:#04af7b}.attention .stat-icon{background:#fff4d8;color:#dca000}.planned .stat-icon{background:#e6f2ff;color:#2285ec}.report-stat div{min-width:0}.report-stat div>span{display:block;font-size:10px;line-height:1.4}.report-stat strong{display:block;font-size:22px;line-height:1.3;font-weight:650}
  .report-navigation{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:0 14px 7px}.report-navigation [role=tablist]{display:flex;gap:15px;min-width:0}.report-navigation button{border:0;background:none;font:11px/1.5 var(--font-sans,sans-serif);color:#7d9598;padding:5px 0;cursor:pointer;white-space:nowrap}.report-navigation [aria-selected=true]{border-bottom:2px solid #0b8c61;color:#087653;font-weight:600}.report-navigation button:focus-visible{outline:2px solid #148660;outline-offset:3px}.report-navigation .source-action{display:flex;align-items:center;gap:5px;border:1px solid #e4ece6;border-radius:5px;padding:5px 8px;color:#37735e}.source-action :global(svg){width:13px;height:13px}.report-panel{margin:0 14px 13px;min-height:171px}.report-panel[hidden]{display:none}.report-panel table{border-collapse:separate;border-spacing:0;width:100%;font-size:10px;text-align:left;border:1px solid #e4edeb;border-radius:6px;overflow:hidden}.report-panel th{font-size:10px;color:#7a9399;background:#f4f8f7;font-weight:500;padding:8px 9px;white-space:nowrap}.report-panel td{padding:7px 9px;border-top:1px solid #eef3f0;line-height:1.5}.report-panel td:first-child{white-space:nowrap}.report-panel td:last-child{font-size:9px;white-space:nowrap;color:#57777b}.task-status{display:inline-block;white-space:nowrap;border-radius:10px;padding:1px 6px;font-size:9px}.task-status.done{background:#e0f9ec;color:#00a564}.task-status.attention{background:#fff4d6;color:#d99900}.task-status.planned{background:#eaf4ff;color:#2389f0}.source-name{display:flex;gap:7px;align-items:center;white-space:nowrap;background:none}.source-name :global(svg){width:14px;height:14px;flex-shrink:0}.source-name>span{color:#34565b}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}.sample-progress{font-size:12px}.sample-progress p,.sample-sources>p{font-size:11px;color:#748e86;line-height:1.6;margin:5px 0 14px}.sample-progress>div{display:grid;grid-template-columns:100px 1fr 24px;align-items:center;gap:10px;margin:17px 0}.sample-progress meter{width:100%;height:14px;accent-color:#21a774}.sample-sources>div{display:grid;grid-template-columns:90px 1fr;gap:8px;font-size:11px;line-height:1.6;margin:10px 0}.sample-sources strong{font-size:11px}
  .demo-uses{display:flex;justify-content:center;margin:28px 0 0;gap:0}.demo-uses>div{display:flex;align-items:center;gap:14px;padding:0 27px;border-right:1px solid #dce9e2}.demo-uses>div:last-child{border:0}.demo-uses :global(svg){width:25px;height:25px;color:#17755d;flex-shrink:0}.demo-uses p{margin:0;font-size:11px;line-height:1.5;color:#889c9f}.demo-uses strong{display:block;color:#294941;font-size:12px;font-weight:600}.demo-uses p>span{display:block}.sample-conversation{border:1px solid #d9e6de;border-radius:18px;padding:23px;max-width:480px;width:calc(100% - 42px);box-sizing:border-box;color:#28493e;box-shadow:0 20px 80px #173c332b}.sample-conversation::backdrop{background:#193c343b}.sample-conversation form{display:flex;gap:20px;align-items:center;justify-content:space-between;margin-bottom:18px}.sample-conversation h2{font-size:18px;margin:0}.sample-conversation form button{border:0;border-radius:5px;font-size:23px;line-height:1;background:#eff5f0;padding:4px 9px;color:#285442;cursor:pointer}.sample-conversation article{background:#f5f8f5;border-radius:9px;padding:13px;margin-top:10px;font-size:13px}.sample-conversation time{float:right;color:#86988e;font-size:11px}.sample-conversation article p{margin:7px 0 0;line-height:1.6}.sample-notice{font-size:11px;line-height:1.6;color:#82938b;margin-bottom:0}
  @media(min-width:1400px){.demo-scene{grid-template-columns:1fr .98fr 1.8fr}.sample-chat p{font-size:14px}.report-panel table{font-size:11px}.report-panel th{font-size:11px}}
  @media(max-width:1050px) and (min-width:781px){.demo-scene{grid-template-columns:1fr 170px 1.6fr}.demo-hub{width:133px;padding:12px 7px}.demo-hub strong{font-size:20px}.scene-bridge{padding-right:30px}.hub-arrow{width:30px}.sample-chat{padding:13px 10px;grid-template-columns:24px 1fr;gap:7px}.chat-avatar{width:24px;height:24px}.chat-avatar :global(svg){width:24px;height:24px}.sample-chat p{font-size:12px;padding:7px}.sample-date{display:none}.report-stats{gap:5px;padding-inline:10px}.report-stat{padding:7px;gap:5px}.stat-icon{width:23px;height:23px}.report-heading{padding-inline:10px}.report-navigation{padding-inline:10px}.report-navigation [role=tablist]{gap:9px}.report-navigation .source-action{font-size:10px;padding:4px}.report-panel{margin-inline:10px}.report-panel td,.report-panel th{padding:7px 5px}.report-panel td:last-child,.report-panel th:last-child{display:none}.scene-note{font-size:13px}.demo-uses>div{padding:0 16px}}
  @media(max-width:780px){.demo-scene{grid-template-columns:1fr;max-width:620px;margin:0 auto}.chat-column{padding-top:38px}.scene-note{position:static;transform:none;margin:0 0 16px;font-size:16px}.scene-note svg{display:none}.chat-column .scene-note{position:absolute;top:0;bottom:auto}.sample-chat{padding:14px 15px}.sample-chat p{font-size:14px}.scene-bridge{height:150px;justify-content:center;padding:0}.chat-wires{display:none}.scene-bridge:before{content:'';position:absolute;top:0;left:50%;height:23px;border-left:1px solid #add9bf}.demo-hub{min-height:105px;width:240px;border-radius:18px;gap:5px;padding:9px;margin-bottom:5px}.demo-hub img{width:32px;height:32px}.demo-hub strong{font-size:21px}.hub-arrow{width:34px;height:20px;right:calc(50% - 17px);top:auto;bottom:0;transform:rotate(90deg)}.output-note{text-align:center;margin:5px 0 17px;white-space:normal}.report-heading h2{font-size:16px}.report-heading p{font-size:11px}.demo-uses{flex-direction:column;max-width:620px;margin:24px auto 0;gap:15px}.demo-uses>div{border:0;padding:0;gap:13px}.demo-uses strong{font-size:13px}.demo-uses p{font-size:12px}}
  @media(max-width:480px){.sample-date{display:none}.report-heading{padding:13px 10px 10px}.report-stats{padding:0 10px 12px;gap:6px}.report-stat{padding:7px 6px;gap:6px}.stat-icon{width:25px;height:25px}.report-stat strong{font-size:21px}.report-stat div>span{font-size:10px}.report-navigation{padding-inline:10px;gap:8px}.report-navigation [role=tablist]{gap:13px}.report-navigation .source-action{font-size:10px;gap:3px;padding:5px}.report-panel{margin-inline:10px}.report-panel td,.report-panel th{padding:8px 6px}.report-panel td:last-child,.report-panel th:last-child{display:none}.report-panel table{font-size:11px}.task-status{font-size:10px;padding:1px 5px}.source-name{gap:4px}.source-name :global(svg){width:12px}.sample-sources>div{grid-template-columns:80px 1fr}}
  @media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto;animation:none!important;transition:none!important}}
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-conversation-demo]').forEach(root => {
    const tabs=Array.from(root.querySelectorAll<HTMLButtonElement>('[data-demo-tab]'));
    const panels=Array.from(root.querySelectorAll<HTMLElement>('[data-demo-panel]'));
    const select=(index:number,focus=false)=>{tabs.forEach((tab,i)=>{tab.setAttribute('aria-selected',String(i===index));tab.tabIndex=i===index?0:-1;});panels.forEach((panel,i)=>panel.hidden=i!==index);if(focus)tabs[index]?.focus();};
    tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>select(i));tab.addEventListener('keydown',event=>{let next=i;if(event.key==='ArrowRight')next=(i+1)%tabs.length;else if(event.key==='ArrowLeft')next=(i-1+tabs.length)%tabs.length;else if(event.key==='Home')next=0;else if(event.key==='End')next=tabs.length-1;else return;event.preventDefault();select(next,true);});});
    const dialog=root.querySelector<HTMLDialogElement>('dialog');
    const trigger=root.querySelector<HTMLButtonElement>('[data-open-demo-source]');
    trigger?.addEventListener('click',()=>dialog?.showModal());
    dialog?.addEventListener('click',event=>{if(event.target===dialog){const box=dialog.getBoundingClientRect();if(event.clientX<box.left||event.clientX>box.right||event.clientY<box.top||event.clientY>box.bottom)dialog.close();}});
    dialog?.addEventListener('close',()=>trigger?.focus());
  });
</script>

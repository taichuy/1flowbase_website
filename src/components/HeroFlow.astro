---
import type { Locale } from '../config';
import Node from './HeroFlowNode.astro';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const zh = lang === 'zh';
const title = zh ? '从 AI 对话到知识库与业务系统' : 'From AI conversations to knowledge and business systems';
const clientNote = zh ? '本地 Agent 接入示例，需配置兼容的模型接口。' : 'An example local agent. A compatible model endpoint must be configured.';
const gateway = zh ? '1flowbase 网关 · Chat' : '1flowbase Gateway · Chat';
const gatewayNote = zh ? '通过网关发送 AI 对话；记录范围、保留策略和访问权限由你配置。' : 'Route AI conversations through the gateway. You configure what is recorded, retention and access permissions.';
const layers = zh ? [
  [['Agent 对话记录','按配置保留对话记录，供有权限的用户回看与使用。','flow'],['业务数据','你定义和管理的业务内容，与下层的 DB 存储能力分开。','database']],
  [['DB','定义数据模型，存储和读取自己的业务数据。',''],['CRUD API','为业务数据提供创建、读取、更新和删除接口。',''],['Workflow API','编排模型、工具与逻辑，通过 API 调用工作流。',''],['React Block','通过 React / TSX 代码区块构建应用界面。','']],
  [['Token 用量','应用场景示例：分析模型使用情况。需按业务需求配置与开发。',''],['知识库','应用场景示例：整理可复用的知识。需配置数据来源、权限与应用逻辑，并非自动生成的现成应用。',''],['业务管理','应用场景示例：基于自己的数据构建业务工具。需配置与开发。',''],['报表','应用场景示例：汇总数据并展示结果。需配置与开发。','']],
  [['GUI 图形界面','用户通过图形界面查看、编辑和管理已配置的应用。','layout'],['MCP 工具接口','Agent 发现并调用你已开放的能力；具体工具和权限需配置。','code']],
  [['用户','在权限范围内直接操作应用。',''],['Agent','通过已开放的 MCP 工具，在授权范围内调用应用能力。','spark']],
] : [
  [['Agent conversations','Retain configured conversation records for authorized users to review and reuse.','flow'],['Business data','Business content you define and manage, separate from the DB storage capability below.','database']],
  [['DB','Define data models to store and read your business data.',''],['CRUD API','Create, read, update and delete business data through APIs.',''],['Workflow API','Compose models, tools and logic, then call workflows through an API.',''],['React Block','Build application interfaces with React / TSX code blocks.','']],
  [['Token usage','Example application: analyze model usage. Configuration and development are required.',''],['Knowledge base','Example application: organize reusable knowledge. Data sources, permissions and logic require setup; this is not an automatically generated ready-made app.',''],['Business tools','Example application: build tools on your own data. Configuration and development are required.',''],['Reports','Example application: summarize data and present results. Configuration and development are required.','']],
  [['GUI interface','People view, edit and manage configured applications through a graphical interface.','layout'],['MCP tools','Agents discover and call capabilities you expose. Tools and permissions require configuration.','code']],
  [['People','Operate the application within their access permissions.',''],['Agents','Call application capabilities through exposed MCP tools and authorized permissions.','spark']],
];
const kinds = ['data','capabilities','apps','interfaces','endpoints'];
---
<div class="hero-flow-widget" data-flow-widget>
<figure class="hero-flow" data-hero-flow aria-label={title}>
  <ol class="hero-flow-layers" role="list">
    <li>
      <div class="flow-layer-panel hero-flow-clients">{['Codex','Claude Code','DeepSeek harness'].map((client,i) => <div class="hero-flow-client"><Node label={client} description={clientNote} id={`flow-client-${i}`}/></div>)}</div>
      <div class="hero-flow-client-lines" aria-hidden="true">{[0,1,2].map(() => <svg viewBox="0 0 20 24"><path d="M10 1v20m-5-5 5 5 5-5"/></svg>)}</div>
      <div class="flow-layer-panel hero-flow-gateway"><Node label={gateway} description={gatewayNote} id="flow-gateway" icon="route"/></div>
      <div class="hero-flow-arrow" aria-hidden="true"><svg viewBox="0 0 20 24"><path d="M10 1v20m-5-5 5 5 5-5"/></svg></div>
    </li>
    {layers.map((nodes,i) => <li>
      <div class:list={['flow-layer-panel','hero-flow-row',`hero-flow-${kinds[i]}`]}>{nodes.map(([label,description,icon],j) => <Node label={label} description={description} icon={icon} id={`flow-node-${i}-${j}`}/>)}</div>
      {i < 3 && <div class="hero-flow-arrow" aria-hidden="true"><svg viewBox="0 0 20 24"><path d="M10 1v20m-5-5 5 5 5-5"/></svg></div>}
      {i === 3 && <div class="hero-flow-arrow-pair" aria-hidden="true">{[0,1].map(() => <svg viewBox="0 0 20 24"><path d="M10 1v20m-5-5 5 5 5-5"/></svg>)}</div>}
    </li>)}
  </ol>
  <div class="flow-tooltip" data-flow-tooltip role="tooltip" aria-hidden="true" hidden></div>
</figure>
<label class="flow-motion-control" hidden data-motion-label>
  <input type="checkbox" role="switch" data-motion-control aria-describedby="flow-motion-status" />
  <span>{zh ? '动态效果' : 'Motion'}</span>
  <span id="flow-motion-status" data-motion-status data-on={zh ? '开启' : 'On'} data-off={zh ? '关闭' : 'Off'} data-system={zh ? '跟随系统：静止' : 'System: reduced motion'} aria-live="polite"></span>
</label>
</div>
<style>
  .hero-flow-widget{min-width:0}
  .hero-flow{margin:0;min-width:0;padding:22px;background:linear-gradient(145deg,#f2f5e9,#f8faf3);border:1px solid #d4dfd1;border-radius:14px;box-shadow:0 13px 50px #52634008;color:#183a30}
  .hero-flow-layers{padding:0;margin:0;list-style:none}
  .hero-flow-layers>li{margin:0;padding:0}
  .flow-layer-panel{position:relative;border-radius:7px;isolation:isolate}
  :global(.hero-explainer-node > .hero-edge-beam){position:absolute;inset:-1px;width:calc(100% + 2px);height:calc(100% + 2px);overflow:visible;pointer-events:none;z-index:1;fill:none;stroke:#397d55;stroke-width:2;stroke-linecap:round;filter:drop-shadow(0 0 2px #8dc77460)}
  :global(.hero-edge-beam path){opacity:0}
  [data-motion=static] :global(.hero-edge-beam){visibility:hidden}
  .flow-motion-control{display:flex;align-items:center;justify-content:flex-end;gap:7px;min-height:32px;margin-top:5px;color:#65725c;font:11px/1.5 var(--font-sans,sans-serif);cursor:pointer}
  .flow-motion-control[hidden]{display:none}
  .flow-motion-control input{width:12px;height:12px;accent-color:#476c53;margin:0}
  .flow-motion-control input:focus-visible{outline:2px solid #176e55;outline-offset:3px}
  .flow-motion-control [data-motion-status]{color:#75816f;font-size:10px}

  .hero-flow-clients,.hero-flow-client-lines{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
  .hero-flow-client{display:grid;min-width:0}
  .hero-flow-client :global(.hero-explainer-node){font-family:var(--font-mono)}
  .hero-flow-gateway :global(.hero-explainer-node){background:#1d4b3b;border-color:#1d4b3b;color:#fff}
  .hero-flow-gateway :global(svg){color:#d4e6cc}
  .hero-flow-gateway :global(.hero-explainer-node:hover){background:#285b47}
  .hero-flow-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
  .hero-flow-capabilities,.hero-flow-apps{grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}
  .hero-flow-capabilities :global(.hero-explainer-node){border-style:dashed;background:#f5f8ef;font-family:var(--font-mono)}
  .hero-flow-apps :global(.hero-explainer-node){background:#e6eedb;border-color:#ccdabc}
  .hero-flow-endpoints :global(.hero-explainer-node){background:#eef3e6;border-color:#afc6a3}
  .hero-flow-arrow,.hero-flow-client-lines,.hero-flow-arrow-pair{height:22px;color:#8a9e7a}
  .hero-flow-arrow svg,.hero-flow-client-lines svg,.hero-flow-arrow-pair svg{height:22px;width:20px;fill:none;stroke:currentColor;stroke-width:1.3;display:block;margin:0 auto}
  .hero-flow-arrow-pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
  .flow-tooltip{position:fixed;z-index:1000;box-sizing:border-box;width:max-content;max-width:min(280px,calc(100vw - 24px));margin:0;padding:11px 13px;border:1px solid #c9d8c1;border-radius:8px;background:#173e31;color:#fff;box-shadow:0 8px 24px #16352625;font:12px/1.65 var(--font-sans,sans-serif);text-align:left;overflow-wrap:anywhere}
  .flow-tooltip[hidden]{display:none}
  @media(max-width:780px){.hero-flow-widget{max-width:560px;width:100%;justify-self:center}.hero-flow{box-sizing:border-box}}
  @media(max-width:480px){.hero-flow{padding:16px 12px}.hero-flow-capabilities,.hero-flow-apps{grid-template-columns:repeat(2,minmax(0,1fr))}.hero-flow-clients,.hero-flow-client-lines{gap:5px}}
  @media(prefers-reduced-motion:reduce){:global(.hero-edge-beam){display:none!important}}
</style>
<script>
  import { installHeroBeam } from '../lib/heroBeam';
  document.querySelectorAll<HTMLElement>('[data-hero-flow]').forEach(flow => {
    const preference = window.matchMedia('(prefers-reduced-motion: reduce)');
    const widget = flow.closest<HTMLElement>('[data-flow-widget]');
    const control = widget?.querySelector<HTMLInputElement>('[data-motion-control]');
    const status = widget?.querySelector<HTMLElement>('[data-motion-status]');
    if (!control || !status) return;
    let enabled = true;
    try { enabled = sessionStorage.getItem('1flowbase:hero-motion') !== 'off'; } catch { /* Storage is optional. */ }
    let visible = false;
    let hovered = false;
    let focused = false;
    let tooltipOpen = false;
    const beam = installHeroBeam(flow);
    const updateMotion = () => {
      const allowed = enabled && !preference.matches;
      flow.dataset.motion = !allowed ? 'static' : visible && !document.hidden && !hovered && !focused && !tooltipOpen ? 'playing' : 'paused';
      beam.sync();
      control.checked = allowed;
      control.disabled = preference.matches;
      const nextStatus = (preference.matches ? status.dataset.system : enabled ? status.dataset.on : status.dataset.off) ?? '';
      if (status.textContent !== nextStatus) status.textContent = nextStatus;
    };
    const observer = new IntersectionObserver(entries => {
      visible = entries.some(entry => entry.isIntersecting);
      updateMotion();
    }, { threshold: 0 });
    observer.observe(flow);
    flow.addEventListener('pointerenter', event => { if (event.pointerType === 'mouse') { hovered = true; updateMotion(); } });
    flow.addEventListener('pointerleave', () => { hovered = false; updateMotion(); });
    flow.addEventListener('focusin', () => { focused = true; updateMotion(); });
    flow.addEventListener('focusout', event => { focused = !!event.relatedTarget && flow.contains(event.relatedTarget as Node); updateMotion(); });
    control.addEventListener('change', () => {
      enabled = control.checked;
      try { sessionStorage.setItem('1flowbase:hero-motion', enabled ? 'on' : 'off'); } catch { /* Storage is optional. */ }
      updateMotion();
    });
    preference.addEventListener('change', updateMotion);
    document.addEventListener('visibilitychange', updateMotion);
    widget?.querySelector<HTMLElement>('[data-motion-label]')?.removeAttribute('hidden');
    updateMotion();

    const tooltip = flow.querySelector<HTMLElement>('[data-flow-tooltip]');
    if (!tooltip) return;
    // Portal to the body so the hero's overflow cannot clip explanations.
    document.body.appendChild(tooltip);
    let active: HTMLButtonElement | null = null;
    let pinned: HTMLButtonElement | null = null;
    let hideTimer: ReturnType<typeof setTimeout> | undefined;
    const position = () => {
      if (!active || tooltip.hidden) return;
      const anchor = active.getBoundingClientRect();
      const box = tooltip.getBoundingClientRect();
      const left = Math.max(12, Math.min(anchor.left + (anchor.width - box.width) / 2, window.innerWidth - box.width - 12));
      const top = anchor.top >= box.height + 20 ? anchor.top - box.height - 8 : anchor.bottom + 8;
      tooltip.style.left = `${left}px`;
      tooltip.style.top = `${Math.max(12, Math.min(top, window.innerHeight - box.height - 12))}px`;
    };
    const close = () => { clearTimeout(hideTimer); active = null; pinned = null; tooltip.hidden = true; tooltipOpen = false; updateMotion(); };
    const show = (button: HTMLButtonElement) => {
      clearTimeout(hideTimer);
      active = button;
      tooltip.textContent = button.dataset.description ?? '';
      tooltip.hidden = false;
      tooltipOpen = true; updateMotion();
      position();
    };
    const leave = () => { if (!pinned && document.activeElement !== active) hideTimer = setTimeout(close, 140); };
    const buttons = Array.from(flow.querySelectorAll<HTMLButtonElement>('[data-flow-node]'));
    buttons.forEach(button => {
      button.addEventListener('pointerenter', event => { if (event.pointerType === 'mouse' && !pinned) show(button); });
      button.addEventListener('pointerleave', leave);
      button.addEventListener('focus', () => show(button));
      button.addEventListener('blur', close);
      button.addEventListener('click', () => { if (pinned === button) close(); else { pinned = button; show(button); } });
      button.addEventListener('keydown', event => { if (event.key === 'Escape') { event.preventDefault(); close(); } });
    });
    tooltip.addEventListener('pointerenter', () => clearTimeout(hideTimer));
    tooltip.addEventListener('pointerleave', leave);
    const outside = (event: PointerEvent) => { if (event.target instanceof Node && !tooltip.contains(event.target) && !buttons.some(button => button.contains(event.target as Node))) close(); };
    const escape = (event: KeyboardEvent) => { if (event.key === 'Escape') close(); };
    document.addEventListener('pointerdown', outside);
    document.addEventListener('keydown', escape);
    window.addEventListener('resize', position);
    window.addEventListener('scroll', close, { passive: true });
    document.addEventListener('astro:before-swap', () => {
      observer.disconnect(); close(); flow.dataset.motion = 'static'; beam.destroy(); tooltip.remove();
      preference.removeEventListener('change', updateMotion);
      document.removeEventListener('visibilitychange', updateMotion);
      document.removeEventListener('pointerdown', outside);
      document.removeEventListener('keydown', escape);
      window.removeEventListener('resize', position);
      window.removeEventListener('scroll', close);
    }, { once: true });
  });
</script>

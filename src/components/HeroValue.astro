---
import type { Locale } from '../config';
import Icon from './RuntimeIcon.astro';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const zh = lang === 'zh';
const sources = ['Claude Code', 'Codex', 'OpenClaw', 'DeepSeek harness', 'AionUi', zh ? '更多 Agent' : 'More agents'];
const connectionNote = zh ? '接入工具示例；需配置兼容的模型接口，具体功能取决于工具、版本与配置。' : 'Example clients. Configure a compatible model endpoint; available capabilities depend on the client, version and setup.';
const evolutionNote = zh ? '这里的自进化指利用记录、记忆与反馈，持续改进应用和 Agent 的行为；需要配置流程与权限，不代表自动训练模型或无需配置的自主学习。' : 'Agent evolution means using records, memory and feedback to improve applications and agent behavior. Workflows and permissions require setup; this does not mean automatic model training or learning without configuration.';
const outcomes = zh ? ['更好的决策', '更深入的洞察', '更好的体验'] : ['Better decisions', 'Deeper insights', 'Better experiences'];
---
<figure class="hero-value" aria-labelledby="hero-value-caption">
  <figcaption id="hero-value-caption"><span class="value-caption-text">{zh ? '聊天 · 沉淀 · 记忆 · Agent 自进化' : 'Chat · Capture · Memory · Agent evolution'}</span><details class="value-note value-note-right" data-value-note><summary title={evolutionNote}>{zh ? '概念说明' : 'Concept note'}</summary><p>{evolutionNote}</p></details></figcaption>
  <div class="value-stages">
  <div class="value-input">
    <div class="value-input-title"><details class="value-note" data-value-note><summary title={connectionNote}>{zh ? '接入示例' : 'Example clients'}</summary><p>{connectionNote}</p></details></div>
    <ul class="value-sources">{sources.map(label => <li><span>{label}</span></li>)}</ul>
  </div>
  <div class="value-connector" aria-hidden="true"><svg viewBox="0 0 64 24"><path d="M2 12h57m-7-6 7 6-7 6"/></svg></div>
  <div class="value-hub">
    <div class="value-brand"><Icon name="route"/><strong>1flowbase</strong></div>
    <p>{zh ? '把分散的 AI 会话，沉淀为自己的数据' : 'Turn scattered AI conversations into data you own'}</p>
    <div class="value-hub-flow"><span><Icon name="flow"/>{zh ? '接入' : 'Connect'}</span><Icon name="arrow"/><span><Icon name="database"/>{zh ? '沉淀' : 'Retain'}</span><Icon name="arrow"/><span><Icon name="spark"/>{zh ? '理解' : 'Understand'}</span></div>
  </div>
  <div class="value-connector single" aria-hidden="true"><svg viewBox="0 0 64 24"><path d="M2 12h57m-7-6 7 6-7 6"/></svg></div>
  <div class="value-insights">
    <div class="value-insight-title"><strong>{zh ? '从聊天记录中长出 AI 应用' : 'Grow AI applications from chat history'}</strong><small>{zh ? '从不同角度，理解自己的数据' : 'See your data from different angles'}</small></div>
    <div class="value-charts" aria-hidden="true">
      <div class="value-chart line"><svg viewBox="0 0 150 55"><path class="chart-axis" d="M8 5v43h135"/><path d="m8 36 22-12 22 7 22-16 22 8 23-5 24-10"/><circle cx="30" cy="24" r="2.5"/><circle cx="74" cy="15" r="2.5"/><circle cx="119" cy="18" r="2.5"/></svg></div>
      <div class="value-chart"><svg viewBox="0 0 80 55"><path class="chart-axis" d="M7 48h68"/><path class="chart-bars" d="M16 48V29m16 19V12m16 36V22m16 26V8"/></svg></div>
      <div class="value-chart"><svg viewBox="0 0 80 55"><circle class="chart-ring-bg" cx="28" cy="27" r="18"/><circle class="chart-ring" cx="28" cy="27" r="18"/><path class="chart-legend" d="M56 17h17m-17 11h13m-13 11h17"/></svg></div>
    </div>
  </div>
  </div>
  <div class="value-feedback" aria-label={zh ? '反馈循环：更好的决策带来更深入的洞察和更好的体验，再反馈到下一次使用' : 'Feedback loop: better decisions, deeper insights and better experiences inform the next conversation'}>
    <svg class="value-return" viewBox="0 0 440 30" preserveAspectRatio="none" aria-hidden="true"><path d="M430 0v8q0 14-18 14H28Q10 22 10 8V0m-4 5 4-5 4 5"/></svg>
    <ol>{outcomes.map((label,i) => <li><Icon name={['layout','spark','flow'][i]}/><span>{label}</span>{i<2&&<span class="feedback-arrow" aria-hidden="true">←</span>}</li>)}</ol>
  </div>
</figure>
<style>
  .hero-value{margin:0;min-width:0;width:100%;box-sizing:border-box;color:#214e3d;background:#f8fbf5;border:1px solid #d5dfcf;border-radius:14px;padding:22px;box-shadow:0 15px 50px #354f2807}
  figcaption{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:20px;color:#244936;font-size:15px;font-weight:600;line-height:1.5}
  .value-caption-text{font-size:15px;font-weight:600;line-height:1.6;color:#244936}
  .value-input-title,.value-insight-title{display:flex;align-items:baseline;justify-content:space-between;gap:10px;margin-bottom:11px}
  strong{font-size:14px;font-weight:600}small{font-size:11px;line-height:1.5;color:#74836c}
  .value-sources{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
  .value-sources li{display:flex;align-items:center;justify-content:center;gap:7px;min-height:42px;border:1px solid #d2dfce;background:#fff;border-radius:7px;font:12px/1.5 var(--font-mono,monospace)}
  .value-sources :global(svg){width:17px;height:17px;flex-shrink:0;color:#52765a}
  .value-connector{height:24px;text-align:center;color:#8eaf94}.value-connector svg{display:block;height:24px;width:75%;margin:auto;fill:none;stroke:currentColor;stroke-width:1.2}.value-connector.single svg{width:20px}
  .value-hub{text-align:center;border:1px solid #739d82;border-radius:10px;padding:16px 15px;background:#eff6ed}
  .value-brand{display:flex;align-items:center;justify-content:center;gap:9px}.value-brand :global(svg){width:25px;height:25px}.value-brand strong{font:650 25px/1.2 var(--font-sans,sans-serif);letter-spacing:-.045em}
  .value-hub p{font-size:12px;line-height:1.6;margin:9px 0 14px;color:#52725d}
  .value-hub-flow{display:flex;align-items:center;justify-content:center;gap:15px}.value-hub-flow>span{display:flex;align-items:center;gap:5px;font-size:11px;white-space:nowrap}.value-hub-flow :global(svg){width:16px;height:16px}.value-hub-flow>:global(svg){width:15px;color:#9cbaa1}
  .value-insights{border:1px solid #d4e0d1;border-radius:9px;background:#fff;padding:13px}
  .value-insight-title{margin-bottom:10px}.value-charts{display:grid;grid-template-columns:1.65fr 1fr 1fr;gap:8px}.value-chart{min-width:0;border:1px solid #e1e9df;border-radius:5px;background:#fcfefb;padding:4px}.value-chart svg{display:block;width:100%;height:49px;fill:none;stroke:#598b70;stroke-width:1.6;stroke-linecap:round}.value-chart circle:not(.chart-ring):not(.chart-ring-bg){fill:#598b70;stroke:none}.chart-axis{stroke:#d6e2d3;stroke-width:1}.chart-bars{stroke:#92b39c;stroke-width:9;stroke-linecap:butt}.chart-ring-bg{stroke:#e0eade;stroke-width:8}.chart-ring{stroke:#77a285;stroke-width:8;stroke-dasharray:45 114;transform:rotate(-90deg);transform-origin:28px 27px}.chart-legend{stroke:#bdcfbf;stroke-width:4}
  .value-feedback{position:relative;padding-top:17px;margin:0 3px}.value-return{position:absolute;inset:0 0 auto;width:100%;height:30px;fill:none;stroke:#9bb7a1;stroke-width:1}
  .value-feedback ol{position:relative;list-style:none;margin:0 14px;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.value-feedback li{position:relative;display:flex;align-items:center;justify-content:center;gap:4px;min-height:30px;background:#f8fbf5;border:1px solid #d5e1d0;border-radius:20px;font-size:11px;line-height:1.3;text-align:center;padding:3px}.value-feedback :global(svg:not(.value-return)){width:13px;height:13px;flex-shrink:0}.feedback-arrow{position:absolute;right:-11px;color:#7a9b82}
  .hero-value{padding:28px 30px 24px;max-width:none}
  figcaption{margin-bottom:23px;font-size:13px;font-weight:500;color:#617a68}
  .value-stages{display:grid;grid-template-columns:minmax(0,1fr) 58px minmax(0,1.35fr) 58px minmax(0,1fr);align-items:stretch}
  .value-input{padding:20px;border:1px solid #d4e0d1;border-radius:10px;background:#fff}
  .value-input-title,.value-insight-title{display:block;margin-bottom:17px}.value-input-title strong,.value-insight-title strong{font-size:16px}.value-input-title small,.value-insight-title small{display:block;margin-top:6px;font-size:12px}
  .value-sources{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.value-sources li{min-height:48px;font-size:12px;justify-content:center;text-align:center;padding:7px;overflow-wrap:anywhere}
  .value-connector{align-self:center;height:24px}.value-connector svg,.value-connector.single svg{width:100%;height:24px}
  .value-hub{display:flex;flex-direction:column;justify-content:center;padding:24px 18px}.value-brand strong{font-size:32px}.value-brand :global(svg){width:31px;height:31px}.value-hub p{font-size:14px;line-height:1.75;margin:16px auto 25px;max-width:280px}.value-hub-flow{gap:12px}.value-hub-flow>span{font-size:13px}
  .value-insights{padding:20px}.value-charts{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.value-chart.line{grid-column:1/-1}.value-chart.line svg{height:70px}.value-chart svg{height:55px}
  .value-feedback{margin:0 7%;padding-top:27px}.value-return{height:44px}.value-feedback ol{direction:rtl;max-width:830px;margin:0 auto;gap:30px}.value-feedback li{direction:ltr;min-height:38px;font-size:12px;padding:5px 10px;gap:7px}.feedback-arrow{right:auto;left:-24px;font-size:17px}
  @media(max-width:1000px) and (min-width:781px){.hero-value{padding:23px 20px}.value-stages{grid-template-columns:minmax(0,1fr) 32px minmax(0,1.25fr) 32px minmax(0,1fr)}.value-input,.value-insights{padding:15px}.value-hub{padding:20px 12px}.value-brand strong{font-size:29px}.value-hub-flow{gap:7px}.value-hub-flow>span{font-size:11px}.value-hub-flow>:global(svg){width:11px}}
  @media(max-width:780px){.hero-value{padding:22px 18px;max-width:620px;justify-self:center}.value-stages{grid-template-columns:1fr}.value-input,.value-insights{padding:18px}.value-sources{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.value-sources li{padding:8px 5px;justify-content:center;flex-direction:column;text-align:center;font-size:12px}.value-connector{height:32px}.value-connector svg,.value-connector.single svg{width:32px;height:24px;transform:rotate(90deg);margin:4px auto}.value-hub{padding:24px 15px}.value-hub p{margin:12px auto 18px}.value-charts{grid-template-columns:1.5fr 1fr 1fr}.value-chart.line{grid-column:auto}.value-chart.line svg{height:55px}.value-feedback{margin:0;padding-top:23px}.value-feedback ol{gap:12px}.value-feedback li{font-size:11px;padding:7px 4px;gap:4px}.feedback-arrow{left:-11px;font-size:13px}}
  @media(max-width:420px){.hero-value{padding:19px 12px}.value-input,.value-insights{padding:15px 12px}.value-sources li{font-size:12px}.value-feedback li{flex-direction:column;min-height:50px}.value-hub-flow{gap:10px}.value-hub-flow>span{font-size:12px}}
  .value-note{position:relative;width:max-content;max-width:100%;font-size:12px;color:#617a68;font-weight:400}.value-note summary{cursor:pointer;list-style:none;text-decoration:underline;text-decoration-style:dotted;text-underline-offset:4px;line-height:1.6}.value-note summary::-webkit-details-marker{display:none}.value-note summary:focus-visible{outline:2px solid #176e55;outline-offset:4px;border-radius:2px}.value-note p{position:absolute;z-index:20;top:100%;left:0;width:280px;max-width:calc(100vw - 70px);box-sizing:border-box;margin:8px 0 0;padding:13px 15px;border-radius:8px;border:1px solid #bfd1bb;background:#173e31;color:#fff;font-size:12px;line-height:1.7;box-shadow:0 8px 24px #16352625}.value-note-right{flex-shrink:0}.value-note-right p{left:auto;right:0}.value-input-title .value-note{font-size:14px;font-weight:600}
  @media(max-width:480px){figcaption{align-items:flex-start;gap:12px}.value-caption-text{font-size:14px}.value-note-right{font-size:10px;margin-top:3px}.value-sources li{font-size:12px;min-height:47px}}
</style>
<script>
  document.querySelectorAll<HTMLDetailsElement>('[data-value-note]').forEach(note => {
    note.addEventListener('keydown', event => { if(event.key === 'Escape') { note.open = false; note.querySelector('summary')?.focus(); } });
    const outside = (event: PointerEvent) => { if(event.target instanceof Node && !note.contains(event.target)) note.open = false; };
    document.addEventListener('pointerdown', outside);
    document.addEventListener('astro:before-swap', () => document.removeEventListener('pointerdown',outside), {once:true});
  });
</script>

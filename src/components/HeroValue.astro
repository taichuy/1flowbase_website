---
import type { Locale } from '../config';
import Icon from './RuntimeIcon.astro';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const zh = lang === 'zh';
const sources = zh ? ['AI 工具', 'Coding Agent', '自建 Agent'] : ['AI tools', 'Coding agents', 'Your agents'];
const outcomes = zh ? ['更好的决策', '更深入的洞察', '更好的体验'] : ['Better decisions', 'Deeper insights', 'Better experiences'];
---
<figure class="hero-value" aria-labelledby="hero-value-caption">
  <figcaption id="hero-value-caption">{zh ? '让每一次对话，留下价值' : 'Make every conversation count'}<span>{zh ? '概念示意' : 'Concept'}</span></figcaption>
  <div class="value-input">
    <div class="value-input-title"><strong>{zh ? '多种 AI 与 Agent' : 'Many AIs and agents'}</strong><small>{zh ? '通过兼容接口接入' : 'Connect through compatible APIs'}</small></div>
    <ul class="value-sources">{sources.map((label,i) => <li><Icon name={['spark','code','flow'][i]}/><span>{label}</span></li>)}</ul>
  </div>
  <div class="value-connector" aria-hidden="true"><svg viewBox="0 0 240 24"><path d="M30 0v5q0 7 12 7h78m90-12v5q0 7-12 7h-78m0-12v22m-4-4 4 4 4-4"/></svg></div>
  <div class="value-hub">
    <div class="value-brand"><Icon name="route"/><strong>1flowbase</strong></div>
    <p>{zh ? '把分散的 AI 会话，沉淀为自己的数据' : 'Turn scattered AI conversations into data you own'}</p>
    <div class="value-hub-flow"><span><Icon name="flow"/>{zh ? '接入' : 'Connect'}</span><Icon name="arrow"/><span><Icon name="database"/>{zh ? '沉淀' : 'Retain'}</span><Icon name="arrow"/><span><Icon name="spark"/>{zh ? '理解' : 'Understand'}</span></div>
  </div>
  <div class="value-connector single" aria-hidden="true"><svg viewBox="0 0 20 24"><path d="M10 0v22m-4-4 4 4 4-4"/></svg></div>
  <div class="value-insights">
    <div class="value-insight-title"><strong>{zh ? '自由组合你的洞察' : 'Compose your own insights'}</strong><small>{zh ? '从不同角度，理解自己的数据' : 'See your data from different angles'}</small></div>
    <div class="value-charts" aria-hidden="true">
      <div class="value-chart line"><svg viewBox="0 0 150 55"><path class="chart-axis" d="M8 5v43h135"/><path d="m8 36 22-12 22 7 22-16 22 8 23-5 24-10"/><circle cx="30" cy="24" r="2.5"/><circle cx="74" cy="15" r="2.5"/><circle cx="119" cy="18" r="2.5"/></svg></div>
      <div class="value-chart"><svg viewBox="0 0 80 55"><path class="chart-axis" d="M7 48h68"/><path class="chart-bars" d="M16 48V29m16 19V12m16 36V22m16 26V8"/></svg></div>
      <div class="value-chart"><svg viewBox="0 0 80 55"><circle class="chart-ring-bg" cx="28" cy="27" r="18"/><circle class="chart-ring" cx="28" cy="27" r="18"/><path class="chart-legend" d="M56 17h17m-17 11h13m-13 11h17"/></svg></div>
    </div>
  </div>
  <div class="value-feedback" aria-label={zh ? '反馈循环：更好的决策带来更深入的洞察和更好的体验，再反馈到下一次使用' : 'Feedback loop: better decisions, deeper insights and better experiences inform the next conversation'}>
    <svg class="value-return" viewBox="0 0 440 30" preserveAspectRatio="none" aria-hidden="true"><path d="M430 0v8q0 14-18 14H28Q10 22 10 8V0m-4 5 4-5 4 5"/></svg>
    <ol>{outcomes.map((label,i) => <li><Icon name={['layout','spark','flow'][i]}/><span>{label}</span>{i<2&&<span class="feedback-arrow" aria-hidden="true">→</span>}</li>)}</ol>
  </div>
</figure>
<style>
  .hero-value{margin:0;min-width:0;width:100%;box-sizing:border-box;color:#214e3d;background:#f8fbf5;border:1px solid #d5dfcf;border-radius:14px;padding:22px;box-shadow:0 15px 50px #354f2807}
  figcaption{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:20px;color:#244936;font-size:15px;font-weight:600;line-height:1.5}
  figcaption>span{font-size:10px;letter-spacing:.04em;color:#778473;font-weight:400;white-space:nowrap}
  .value-input-title,.value-insight-title{display:flex;align-items:baseline;justify-content:space-between;gap:10px;margin-bottom:11px}
  strong{font-size:14px;font-weight:600}small{font-size:11px;line-height:1.5;color:#74836c}
  .value-sources{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
  .value-sources li{display:flex;align-items:center;justify-content:center;gap:7px;min-height:42px;border:1px solid #d2dfce;background:#fff;border-radius:7px;font:12px/1.5 var(--font-mono,monospace)}
  .value-sources :global(svg){width:17px;height:17px;flex-shrink:0;color:#52765a}
  .value-connector{height:24px;text-align:center;color:#8eaf94}.value-connector svg{display:block;height:24px;width:75%;margin:auto;fill:none;stroke:currentColor;stroke-width:1.2}.value-connector.single svg{width:20px}
  .value-hub{text-align:center;border:1px solid #739d82;border-radius:10px;padding:16px 15px;background:#eff6ed}
  .value-brand{display:flex;align-items:center;justify-content:center;gap:9px}.value-brand :global(svg){width:25px;height:25px}.value-brand strong{font:650 25px/1.2 var(--font-sans,sans-serif);letter-spacing:-.045em}
  .value-hub p{font-size:12px;line-height:1.6;margin:9px 0 14px;color:#52725d}
  .value-hub-flow{display:flex;align-items:center;justify-content:center;gap:15px}.value-hub-flow>span{display:flex;align-items:center;gap:5px;font-size:11px;white-space:nowrap}.value-hub-flow :global(svg){width:16px;height:16px}.value-hub-flow>:global(svg){width:15px;color:#9cbaa1}
  .value-insights{border:1px solid #d4e0d1;border-radius:9px;background:#fff;padding:13px}
  .value-insight-title{margin-bottom:10px}.value-charts{display:grid;grid-template-columns:1.65fr 1fr 1fr;gap:8px}.value-chart{min-width:0;border:1px solid #e1e9df;border-radius:5px;background:#fcfefb;padding:4px}.value-chart svg{display:block;width:100%;height:49px;fill:none;stroke:#598b70;stroke-width:1.6;stroke-linecap:round}.value-chart circle:not(.chart-ring):not(.chart-ring-bg){fill:#598b70;stroke:none}.chart-axis{stroke:#d6e2d3;stroke-width:1}.chart-bars{stroke:#92b39c;stroke-width:9;stroke-linecap:butt}.chart-ring-bg{stroke:#e0eade;stroke-width:8}.chart-ring{stroke:#77a285;stroke-width:8;stroke-dasharray:45 114;transform:rotate(-90deg);transform-origin:28px 27px}.chart-legend{stroke:#bdcfbf;stroke-width:4}
  .value-feedback{position:relative;padding-top:17px;margin:0 3px}.value-return{position:absolute;inset:0 0 auto;width:100%;height:30px;fill:none;stroke:#9bb7a1;stroke-width:1}
  .value-feedback ol{position:relative;list-style:none;margin:0 14px;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.value-feedback li{position:relative;display:flex;align-items:center;justify-content:center;gap:4px;min-height:30px;background:#f8fbf5;border:1px solid #d5e1d0;border-radius:20px;font-size:11px;line-height:1.3;text-align:center;padding:3px}.value-feedback :global(svg:not(.value-return)){width:13px;height:13px;flex-shrink:0}.feedback-arrow{position:absolute;right:-11px;color:#7a9b82}
  @media(max-width:1050px) and (min-width:781px){.hero-value{padding:16px}.value-input-title,.value-insight-title{display:block}.value-input-title small,.value-insight-title small{display:block;margin-top:3px}.value-hub-flow{gap:9px}.value-feedback li{font-size:10px}}
  @media(max-width:780px){.hero-value{max-width:560px;justify-self:center}}
  @media(max-width:480px){.hero-value{padding:17px 13px}figcaption{font-size:14px;margin-bottom:17px}.value-input-title,.value-insight-title{display:block}.value-input-title small,.value-insight-title small{display:block;margin-top:3px}.value-sources{gap:5px}.value-sources li{font-size:11px;gap:4px}.value-sources :global(svg){width:14px;height:14px}.value-hub{padding:15px 9px}.value-hub-flow{gap:8px}.value-feedback ol{margin:0 6px;gap:9px}.value-feedback li{font-size:10px}.feedback-arrow{right:-9px}}
</style>

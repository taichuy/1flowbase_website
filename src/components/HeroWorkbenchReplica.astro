---
import type { Locale } from '../config';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const zh = lang === 'zh';

const topTabs = zh
  ? ['AI Gateway', '应用底座', 'GUI & MCP']
  : ['AI Gateway', 'App Foundation', 'GUI & MCP'];

const gwSubTabs = zh
  ? ['智能路由', 'Fusion 并行', '按模型分发', '轮询 · 重试轮询']
  : ['Smart Routing', 'Fusion Parallel', 'Model Dispatch', 'Round-Robin & Retry'];

const gwDescs = zh
  ? [
      '主模型理解用户意图，按需调用底部挂载的专长分支模型（工具模式：智能路由），兼顾效果与成本。',
      '主模型一次触发多路分支模型并行推理，经汇总节点合并为单一 Tool Result 返回（源自 Fusion 画布）。',
      '内置 AI 网关工作流模板：按客户端请求的 model 条件分发至对应模型分支，自动互转三大协议。',
      '模型供应商「主实例 · 聚合视图」：多账号密钥注入同一模型，支持按分组顺序轮询与 429 自动顺延重试。',
    ]
  : [
      'A primary LLM挂载 specialized branch LLMs in Smart Routing tool mode, dispatching sub-tasks by intent.',
      'One tool trigger fans out to parallel branch LLMs and merges through a synthesizer node into one Tool Result.',
      'Built-in gateway workflow template: branches by requested model ID with automatic 3-protocol translation.',
      'Provider Main Instance Aggregation View: pool multiple keys under one model with round-robin & auto-retry.',
    ];
---

<div class="wb-shell" data-wb-replica data-active-scene="0" data-gw-descs={JSON.stringify(gwDescs)}>
  <!-- Real 1flowbase top bar with clickable synchronized tabs & authentic UI / AI mode chips -->
  <div class="wb-topbar">
    <div class="wb-brand">
      <img src="/favicon.svg" alt="" width="18" height="18" />
      <strong>1flowbase</strong>
    </div>

    <div class="wb-nav" role="tablist" aria-label={zh ? '切换首屏核心场景' : 'Switch core capability view'}>
      {topTabs.map((tab, idx) => (
        <button
          type="button"
          role="tab"
          class:list={['wb-tab-btn', idx === 0 && 'active']}
          aria-selected={idx === 0 ? 'true' : 'false'}
          data-wb-tab={idx}
        >
          {tab}
        </button>
      ))}
    </div>

    <div class="wb-actions" aria-hidden="true">
      <span class="wb-mode-chip" data-wb-badge="0">▷ {zh ? '预览' : 'Preview'} · {zh ? '发布' : 'publish'}</span>
      <span class="wb-mode-chip ui-mode" data-wb-badge="1" hidden>+ {zh ? '添加菜单' : 'Menu'} · <b>UI</b></span>
      <span class="wb-mode-chip dual-mode" data-wb-badge="2" hidden>
        <b class="b-ui">UI</b>
        <i>·</i>
        <b class="b-ai">AI · MCP</b>
      </span>
    </div>
  </div>

  <!-- =====================================================================
       SCENE 0 (1): AI Gateway -> 4 Authentic 1flowbase Views from 1flowbase-readme.md
       0: 智能路由 (image-20261111231330735.png + smart-routing)
       1: Fusion 并行 (fusion-workflow-canvas.png)
       2: 按模型分发 (image-20261111224458906.png)
       3: 轮询 · 重试轮询 (image-20261111222043915.png + 222108505.png)
       ===================================================================== -->
  <div class="wb-scene" data-wb-panel="0">
    <div class="gw-native-shell">
      <!-- Top Mode Bar -->
      <div class="gw-top-strip">
        <div class="gw-seg-pills" role="tablist" aria-label={zh ? '切换 1flowbase 网关模式' : 'Switch 1flowbase gateway mode'}>
          {gwSubTabs.map((lbl, idx) => (
            <button
              type="button"
              role="tab"
              class:list={['gw-seg-btn', idx === 0 && 'active']}
              aria-selected={idx === 0 ? 'true' : 'false'}
              data-gw-mode={idx}
            >
              {lbl}
            </button>
          ))}
        </div>
        <p class="gw-mode-desc" data-gw-desc>{gwDescs[0]}</p>
      </div>

      <!-- MODE 0: 智能路由 (Authentic 1flowbase Agent Flow: Start -> Main LLM -> Answer + Mounted Smart-Routing Tool Branches) -->
      <div class="gw-subpanel dot-canvas" data-gw-panel="0" data-canvas-gw="0">
        <canvas class="wb-wire-canvas" data-gw-canvas="0" aria-hidden="true"></canvas>

        <div class="af-top-chain">
          <div class="af-node">
            <div class="af-hd"><span class="af-ico start">▷</span><strong>Start</strong></div>
            <div class="af-bd muted">{zh ? '工作流入口。' : 'Workflow entry.'}</div>
            <i class="af-port p-r" data-port="m0-start-r"></i>
          </div>

          <div class="af-node af-active">
            <i class="af-port p-l" data-port="m0-main-l"></i>
            <div class="af-hd">
              <span class="af-ico llm">⚡</span>
              <strong>LLM</strong>
              <em class="af-chip">{zh ? '挂载 LLM' : 'Mount LLM'}</em>
            </div>
            <div class="af-bd model-row">
              <span class="v-dot claude">AI</span>
              <div><small>Anthropic</small><b>claude-opus-4-6</b></div>
            </div>
            <i class="af-port p-r" data-port="m0-main-r"></i>
            <div class="af-b-ports">
              <i class="af-port" data-port="m0-main-b1"></i>
              <i class="af-port" data-port="m0-main-b2"></i>
            </div>
          </div>

          <div class="af-node">
            <i class="af-port p-l" data-port="m0-ans-l"></i>
            <div class="af-hd"><span class="af-ico ans">💬</span><strong>Answer</strong></div>
            <div class="af-bd muted">{zh ? '向用户返回最终文本结果。' : 'Return final response.'}</div>
          </div>
        </div>

        <!-- Bottom mounted Smart-Routing tool branches -->
        <div class="sr-branches">
          <div class="sr-branch-row hit">
            <span class="sr-mode-tag">{zh ? '工具模式：智能路由 · 已命中' : 'Tool Mode: Smart Routing · Hit'}</span>
            <div class="af-node af-active">
              <i class="af-port p-l" data-port="m0-b1-l"></i>
              <div class="af-hd"><span class="af-ico llm">⚡</span><strong>backend_dev</strong></div>
              <div class="af-bd model-row">
                <span class="v-dot deepseek">D</span>
                <div><small>DeepSeek · {zh ? '后端开发' : 'Backend'}</small><b>deepseek-v4.1-flash</b></div>
              </div>
              <i class="af-port p-r" data-port="m0-b1-r"></i>
            </div>

            <div class="af-node af-active">
              <i class="af-port p-l" data-port="m0-tr1-l"></i>
              <div class="af-hd"><span class="af-ico ans">💬</span><strong>Tool Result</strong></div>
              <div class="af-bd muted">{zh ? '定义工具调用返回内容。' : 'Return branch tool output.'}</div>
            </div>
          </div>

          <div class="sr-branch-row">
            <div class="af-node">
              <i class="af-port p-l" data-port="m0-b2-l"></i>
              <div class="af-hd"><span class="af-ico llm">⚡</span><strong>image_llm</strong></div>
              <div class="af-bd model-row">
                <span class="v-dot gemini">✦</span>
                <div><small>GLM / Gemini · {zh ? '视觉识图' : 'Vision'}</small><b>glm-4.6v-flash</b></div>
              </div>
              <i class="af-port p-r" data-port="m0-b2-r"></i>
            </div>

            <div class="af-node">
              <i class="af-port p-l" data-port="m0-tr2-l"></i>
              <div class="af-hd"><span class="af-ico ans">💬</span><strong>Tool Result2</strong></div>
              <div class="af-bd muted">{zh ? '按需挂载视觉分支返回。' : 'Return vision output.'}</div>
            </div>
          </div>
        </div>
      </div>

      <!-- MODE 1: Fusion 并行 (1:1 Replica of fusion-workflow-canvas.png) -->
      <div class="gw-subpanel dot-canvas" data-gw-panel="1" data-canvas-gw="1" hidden>
        <canvas class="wb-wire-canvas" data-gw-canvas="1" aria-hidden="true"></canvas>

        <div class="af-top-chain">
          <div class="af-node">
            <div class="af-hd"><span class="af-ico start">▷</span><strong>Start</strong></div>
            <div class="af-bd muted">{zh ? '工作流入口。' : 'Workflow entry.'}</div>
            <i class="af-port p-r" data-port="m1-start-r"></i>
          </div>

          <div class="af-node af-active">
            <i class="af-port p-l" data-port="m1-main-l"></i>
            <div class="af-hd"><span class="af-ico llm">⚡</span><strong>LLM</strong></div>
            <div class="af-bd model-row">
              <span class="v-dot claude">AI</span>
              <div><small>Anthropic</small><b>claude-opus-4-6</b></div>
            </div>
            <i class="af-port p-r" data-port="m1-main-r"></i>
            <div class="af-b-ports single">
              <i class="af-port" data-port="m1-main-b"></i>
            </div>
          </div>

          <div class="af-node">
            <i class="af-port p-l" data-port="m1-ans-l"></i>
            <div class="af-hd"><span class="af-ico ans">💬</span><strong>Answer</strong></div>
            <div class="af-bd muted">{zh ? '向用户返回最终文本结果。' : 'Return final response.'}</div>
          </div>
        </div>

        <!-- Exact Red-Boxed Parallel Fan-out -> Merge -> Tool Result from fusion-workflow-canvas.png -->
        <div class="fusion-box-replica">
          <span class="fusion-badge">工具模式：fusion · {zh ? '多节点并行汇聚' : 'Parallel Fan-out & Merge'}</span>

          <div class="fusion-col-workers">
            <div class="af-node compact af-active">
              <i class="af-port p-l" data-port="m1-w1-l"></i>
              <div class="af-hd"><span class="af-ico llm">⚡</span><strong>LLM1</strong></div>
              <div class="af-bd model-row">
                <span class="v-dot claude">AI</span>
                <div><small>Anthropic</small><b>claude-sonnet-4</b></div>
              </div>
              <i class="af-port p-r" data-port="m1-w1-r"></i>
            </div>

            <div class="af-node compact af-active">
              <i class="af-port p-l" data-port="m1-w2-l"></i>
              <div class="af-hd"><span class="af-ico llm">⚡</span><strong>LLM2</strong></div>
              <div class="af-bd model-row">
                <span class="v-dot gemini">✦</span>
                <div><small>Gemini</small><b>gemini-3-flash</b></div>
              </div>
              <i class="af-port p-r" data-port="m1-w2-r"></i>
            </div>

            <div class="af-node compact af-active">
              <i class="af-port p-l" data-port="m1-w3-l"></i>
              <div class="af-hd"><span class="af-ico llm">⚡</span><strong>LLM3</strong></div>
              <div class="af-bd model-row">
                <span class="v-dot openai">◎</span>
                <div><small>OpenAI</small><b>gpt-5.4</b></div>
              </div>
              <i class="af-port p-r" data-port="m1-w3-r"></i>
            </div>
          </div>

          <div class="af-node compact af-active">
            <i class="af-port p-l" data-port="m1-merge-l"></i>
            <div class="af-hd"><span class="af-ico llm">⚡</span><strong>LLM4 · {zh ? '汇总' : 'Merge'}</strong></div>
            <div class="af-bd model-row">
              <span class="v-dot deepseek">D</span>
              <div><small>DeepSeek</small><b>deepseek-v4</b></div>
            </div>
            <i class="af-port p-r" data-port="m1-merge-r"></i>
          </div>

          <div class="af-node compact af-active">
            <i class="af-port p-l" data-port="m1-tr-l"></i>
            <div class="af-hd"><span class="af-ico ans">💬</span><strong>Tool Result1</strong></div>
            <div class="af-bd muted">{zh ? '定义工具调用返回内容。' : 'Merged tool output.'}</div>
          </div>
        </div>
      </div>

      <!-- MODE 2: 按模型分发 (1:1 Replica of image-20261111224458906.png: 请求输入 -> 按模型分发 -> 模型列 -> 选取已执行分支 -> 直接回复) -->
      <div class="gw-subpanel dot-canvas" data-gw-panel="2" data-canvas-gw="2" hidden>
        <canvas class="wb-wire-canvas" data-gw-canvas="2" aria-hidden="true"></canvas>

        <div class="dispatch-5col">
          <div class="af-node compact">
            <div class="af-hd"><span class="af-ico start">▷</span><strong>{zh ? '请求输入' : 'Request In'}</strong></div>
            <div class="af-bd muted">{zh ? '工作流入口。' : 'Gateway entry.'}</div>
            <i class="af-port p-r" data-port="m2-in-r"></i>
          </div>

          <div class="af-node dispatch-switch af-active">
            <i class="af-port p-l" data-port="m2-sw-l"></i>
            <div class="af-hd"><span class="af-ico route">⇆</span><strong>{zh ? '按模型分发' : 'Model Switch'}</strong></div>
            <div class="af-bd muted">{zh ? '按 model 选择路径' : 'Branch by model'}</div>
            <div class="sw-r-ports">
              <i class="af-port" data-port="m2-sw-1"></i>
              <i class="af-port" data-port="m2-sw-2"></i>
              <i class="af-port" data-port="m2-sw-3"></i>
            </div>
          </div>

          <div class="dispatch-models-col">
            <div class="af-node compact af-active">
              <i class="af-port p-l" data-port="m2-m1-l"></i>
              <div class="af-hd"><span class="af-ico llm">⚡</span><strong>deepseek-flash</strong></div>
              <div class="af-bd model-row">
                <span class="v-dot deepseek">D</span>
                <div><small>deepseek</small><b>deepseek-v4.1-flash</b></div>
              </div>
              <i class="af-port p-r" data-port="m2-m1-r"></i>
            </div>

            <div class="af-node compact">
              <i class="af-port p-l" data-port="m2-m2-l"></i>
              <div class="af-hd"><span class="af-ico llm">⚡</span><strong>gpt-5.4</strong></div>
              <div class="af-bd model-row">
                <span class="v-dot openai">◎</span>
                <div><small>openai</small><b>gpt-5.4</b></div>
              </div>
              <i class="af-port p-r" data-port="m2-m2-r"></i>
            </div>

            <div class="af-node compact">
              <i class="af-port p-l" data-port="m2-m3-l"></i>
              <div class="af-hd"><span class="af-ico llm">⚡</span><strong>claude-opus-4</strong></div>
              <div class="af-bd model-row">
                <span class="v-dot claude">AI</span>
                <div><small>anthropic</small><b>claude-opus-4-6</b></div>
              </div>
              <i class="af-port p-r" data-port="m2-m3-r"></i>
            </div>
          </div>

          <div class="af-node compact af-active">
            <i class="af-port p-l" data-port="m2-pick-l"></i>
            <div class="af-hd"><span class="af-ico pick">◫</span><strong>{zh ? '选取分支' : 'Pick Branch'}</strong></div>
            <div class="af-bd muted">{zh ? '取首个已执行值' : 'First active value'}</div>
            <i class="af-port p-r" data-port="m2-pick-r"></i>
          </div>

          <div class="af-node compact af-active">
            <i class="af-port p-l" data-port="m2-out-l"></i>
            <div class="af-hd"><span class="af-ico ans">💬</span><strong>{zh ? '直接回复' : 'Direct Reply'}</strong></div>
            <div class="af-bd muted">{zh ? '流式返回结果' : 'Stream reply'}</div>
          </div>
        </div>
      </div>

      <!-- MODE 3: 轮询 · 重试轮询 (1:1 Replica of image-20261111222043915.png + 222108505.png: 模型供应商 -> 主实例 [聚合视图] & 来源管理) -->
      <div class="gw-subpanel provider-pool-panel" data-gw-panel="3" hidden>
        <div class="pp-modal-card">
          <div class="pp-head">
            <div class="pp-title-grp">
              <strong>{zh ? 'DeepSeek / Anthropic 实例 · 主实例' : 'Main Instance'}</strong>
              <span class="pp-agg-badge">{zh ? '聚合视图' : 'Aggregate View'}</span>
              <span class="pp-cnt">{zh ? '实例: 3 · 模型: 1' : 'Instances: 3 · Models: 1'}</span>
            </div>
            <div class="pp-auto-switch">
              <span>{zh ? '新实例自动注入主实例' : 'Auto-inject new instances'}</span>
              <i class="sw-on" aria-hidden="true"></i>
            </div>
          </div>

          <!-- Main Instance Aggregation Row (from image-20261111222043915.png) -->
          <div class="pp-policy-bar">
            <div class="pp-col">
              <small>{zh ? '模型 ID' : 'Model ID'}</small>
              <code>deepseek/deepseek-v4.1-flash</code>
            </div>
            <div class="pp-col">
              <small>{zh ? '参与分组顺序' : 'Group Order'}</small>
              <div class="pp-tags">
                <span class="ptag green">commandcode</span>
                <span class="ptag sky">team-prod</span>
                <span class="ptag purple">opencode</span>
              </div>
            </div>
            <div class="pp-col">
              <small>{zh ? '分发规则' : 'Distribution Rule'}</small>
              <span class="pp-select">{zh ? '重试轮询 ▾' : 'Retry round robin ▾'}</span>
            </div>
          </div>

          <!-- Injected Source Instances List (from image-20261111222108505.png) -->
          <div class="pp-sources-list">
            <div class="pp-src-row warn">
              <span class="drag-h">⠿</span>
              <strong>commandcode</strong>
              <b class="st-badge amber">{zh ? '429 限流 · 自动顺延' : '429 · Skipped'}</b>
              <span class="src-url">https://api.commandcode.ai/provider/v1</span>
              <span class="inj-lbl">{zh ? '注入主实例' : 'Injected'} <i class="sw-on sm"></i></span>
            </div>

            <div class="pp-src-row active">
              <span class="drag-h">⠿</span>
              <strong>team-prod</strong>
              <b class="st-badge ready">ready · {zh ? '轮询接管' : 'Active'}</b>
              <span class="src-url">https://api.deepseek.com/v1</span>
              <span class="inj-lbl">{zh ? '注入主实例' : 'Injected'} <i class="sw-on sm"></i></span>
            </div>

            <div class="pp-src-row">
              <span class="drag-h">⠿</span>
              <strong>opencode</strong>
              <b class="st-badge ready">ready</b>
              <span class="src-url">https://openrouter.ai/api/v1</span>
              <span class="inj-lbl">{zh ? '注入主实例' : 'Injected'} <i class="sw-on sm"></i></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Native 1flowbase AI chat history footer bar -->
      <div class="gw-log-strip">
        <div class="gls-left">
          <span class="gls-dot"></span>
          <strong>AI chat history</strong>
          <span class="gls-sub">{zh ? '网关经过的所有会话与工具轨迹自动三级留存入库' : 'All gateway sessions & tool traces auto-saved in 3 tiers'}</span>
        </div>
        <div class="gls-gantt" aria-hidden="true">
          <span>{zh ? '输入' : 'In'} <i class="g-gray" style="width:16px"></i></span>
          <span>{zh ? '模型' : 'LLM'} <i class="g-purple" style="width:34px"></i></span>
          <span>{zh ? '工具' : 'Tool'} <i class="g-orange" style="width:22px"></i></span>
        </div>
        <span class="gls-ok">PostgreSQL ✓</span>
      </div>
    </div>
  </div>

  <!-- =====================================================================
       SCENE 1 (3): 业务应用底座 -> 三幕真实操作动画（不拥挤，全宽逐幕演示）
       Act 0: 主数据源动态建物理表 (image-20261115095705519.png)
       Act 1: TSX 编辑器编写并点击 [运行] (5155c1d0445f71f6d088c33937a57da50e7af1fb.png)
       Act 2: 渲染交付完整企业 Wiki 业务系统 (6bc0a78473668d4ef7bc88a51865dfe7a33ff310.jpeg)
       ===================================================================== -->
  <div class="wb-scene" data-wb-panel="1" hidden>
    <div class="s1-demo-shell">
      <div class="s1-stage" data-s1-stage>
        <!-- Animated Pointer + Click Ripple Overlay -->
        <div class="s1-cursor" data-s1-cursor aria-hidden="true">
          <span class="s1-ripple" data-s1-ripple></span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
            <path
              d="M5.5 3.5L19 10.8L12.2 12.9L9.8 19.8L5.5 3.5Z"
              fill="#0f172a"
              stroke="#ffffff"
              stroke-width="1.8"
              stroke-linejoin="round"
            />
          </svg>
        </div>

        <!-- ACT 0: Full-width replica of 主数据源 · 动态物理表 (095705519.png) -->
        <div class="s1-act is-active" data-s1-act="0">
          <div class="ds-screen">
            <div class="ds-crumb">⌂ {zh ? '数据源管理' : 'Data Sources'} / <b>{zh ? '主数据源' : 'Primary DB'}</b></div>

            <div class="ds-toolbar">
              <div class="ds-title-row">
                <span class="ds-back">←</span>
                <strong>🗄 {zh ? '主数据源' : 'Primary PostgreSQL'}</strong>
                <b class="ds-ready">{zh ? '就绪' : 'Ready'}</b>
              </div>
              <div class="ds-actions-row">
                <span class="ds-new-btn">+ {zh ? '新建数据表' : 'New Table'}</span>
                <span class="ds-open-toggle">{zh ? '开放' : 'Open'} <i></i></span>
              </div>
            </div>

            <div class="ds-table">
              <div class="ds-thead">
                <span></span>
                <span>Data Model</span>
                <span>{zh ? '表类型' : 'Type'}</span>
                <span>API {zh ? '状态' : 'Status'}</span>
                <span>{zh ? '字段数' : 'Cols'}</span>
                <span>{zh ? '操作' : 'Action'}</span>
              </div>

              <div class="ds-trow selected">
                <span class="ds-radio on"></span>
                <div class="ds-model-cell">
                  <strong>Enterprise Wiki Documents</strong>
                  <code>wiki_documents</code>
                </div>
                <span class="ds-type">{zh ? '树状表' : 'Tree'}</span>

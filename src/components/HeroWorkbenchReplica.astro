    let visible = true;

    // Scene 1 3-act timing & smooth cursor state
    const S1_ACT_MS = 4600;
    let s1StartTime = performance.now();
    let s1LastFrame = performance.now();
    let s1AppliedAct = -1;
    let s1PinnedAct: number | null = null;
    let s1CurX = 240;
    let s1CurY = 180;
    let s1ClickedInAct = false;

    // Scene 2 camera & sequential state
    let s2StartTime = performance.now();
    let s2LastFrame = performance.now();
    let s2CamX = 0;
    let s2AppliedBeat = -1;
    let s2PinnedBeat: number | null = null;

    const getGwSurface = (gwIdx: number) => {
      const wrap = root.querySelector<HTMLElement>(`[data-canvas-gw="${gwIdx}"]`);
      const canvas = root.querySelector<HTMLCanvasElement>(`[data-gw-canvas="${gwIdx}"]`);
      const ctx = canvas?.getContext('2d') ?? null;
      return { wrap, canvas, ctx };
    };

    const getS2Surface = () => {
      const wrap = root.querySelector<HTMLElement>('[data-canvas-scene="2"]');
      const canvas = root.querySelector<HTMLCanvasElement>('[data-scene-canvas="2"]');
      const ctx = canvas?.getContext('2d') ?? null;
      return { wrap, canvas, ctx };
    };

    const resizeSurface = (wrap: HTMLElement | null, canvas: HTMLCanvasElement | null, ctx: CanvasRenderingContext2D | null) => {
      if (!wrap || !canvas || !ctx) return;
      const rect = wrap.getBoundingClientRect();
      if (rect.width < 10) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.max(1, Math.floor(rect.width * dpr));
      canvas.height = Math.max(1, Math.floor(rect.height * dpr));
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const getPortPos = (wrap: HTMLElement, name: string, baseRect: DOMRect) => {
      const el = wrap.querySelector<HTMLElement>(`[data-port="${name}"]`);
      if (!el) return null;
      const r = el.getBoundingClientRect();
      return {
        x: r.left - baseRect.left + r.width / 2,
        y: r.top - baseRect.top + r.height / 2,
      };
    };

    const cubicPoint = (
      p0: { x: number; y: number },
      p1: { x: number; y: number },
      p2: { x: number; y: number },
      p3: { x: number; y: number },
      t: number
    ) => {
      const u = 1 - t;
      const tt = t * t;
      const uu = u * u;
      return {
        x: uu * u * p0.x + 3 * uu * t * p1.x + 3 * u * tt * p2.x + tt * t * p3.x,
        y: uu * u * p0.y + 3 * uu * t * p1.y + 3 * u * tt * p2.y + tt * t * p3.y,
      };
    };

    const drawGwWires = (now: number) => {
      const wires = GW_WIRES[currentGwMode];
      if (!wires) return;
      const { wrap, ctx } = getGwSurface(currentGwMode);
      if (!wrap || !ctx) return;
      const rect = wrap.getBoundingClientRect();
      if (rect.width < 10) return;
      ctx.clearRect(0, 0, rect.width, rect.height);
      const phase = (now * 0.00048) % 1;

      wires.forEach(([from, to, mode, active], idx) => {
        const p0 = getPortPos(wrap, from, rect);
        const p3 = getPortPos(wrap, to, rect);
        if (!p0 || !p3) return;

        let p1 = { x: p0.x, y: p0.y };
        let p2 = { x: p3.x, y: p3.y };

        if (mode === 'down') {
          p1 = { x: p0.x, y: p0.y + Math.max(28, (p3.y - p0.y) * 0.65) };
          p2 = { x: p3.x - 28, y: p3.y };
        } else {
          const dx = Math.max(14, Math.abs(p3.x - p0.x) * 0.48);
          p1 = { x: p0.x + dx, y: p0.y };
          p2 = { x: p3.x - dx, y: p3.y };
        }

        ctx.beginPath();
        ctx.moveTo(p0.x, p0.y);
        ctx.bezierCurveTo(p1.x, p1.y, p2.x, p2.y, p3.x, p3.y);
        ctx.strokeStyle = active ? 'rgba(104, 146, 132, 0.78)' : 'rgba(168, 192, 184, 0.45)';
        ctx.lineWidth = active ? 1.55 : 1.25;
        ctx.stroke();

        if (active && !reduced) {
          const t = (phase + idx * 0.14) % 1;
          const pt = cubicPoint(p0, p1, p2, p3, t);
          ctx.beginPath();
          ctx.arc(pt.x, pt.y, 3.2, 0, Math.PI * 2);
          ctx.fillStyle = '#1677ff';
          ctx.shadowColor = '#1677ff';
          ctx.shadowBlur = 6;
          ctx.fill();
          ctx.shadowBlur = 0;
        }
      });
    };

    const applyS2BeatDOM = (beatIdx: number) => {
      if (s2AppliedBeat === beatIdx) return;
      s2AppliedBeat = beatIdx;
      const beat = S2_BEATS[beatIdx] ?? S2_BEATS[0];

      s2Nodes.forEach((el, key) => {
        const isCurrent = beat.current.includes(key);
        const isLit = beat.lit.includes(key);
        el.classList.toggle('is-current', isCurrent);
        el.classList.toggle('is-lit', isLit);
        el.classList.toggle('is-dim', !isCurrent && !isLit);
      });

      s2StepBtns.forEach((btn, idx) => {
        btn.classList.toggle('active', idx === beat.stepIdx);
      });
    };

    const drawScene2Parity = (now: number) => {
      const { wrap, ctx } = getS2Surface();
      if (!wrap || !ctx || !s2Viewport || !s2World) return;

      const dt = Math.min(64, Math.max(1, now - s2LastFrame));
      s2LastFrame = now;

      const totalCycle = S2_BEATS.length * BEAT_MS;
      const elapsed = (now - s2StartTime) % totalCycle;
      const autoBeatIdx = Math.min(S2_BEATS.length - 1, Math.floor(elapsed / BEAT_MS));
      const beatIdx = s2PinnedBeat !== null ? s2PinnedBeat : reduced ? 7 : autoBeatIdx;
      const beat = S2_BEATS[beatIdx] ?? S2_BEATS[0];

      applyS2BeatDOM(beatIdx);

      // Smooth damped camera pan across the 1060px world
      const worldW = s2World.offsetWidth;
      const viewW = s2Viewport.clientWidth;
      const maxPan = Math.max(0, worldW - viewW);
      const targetCamX = maxPan * beat.pan;

      if (reduced) {
        s2CamX = targetCamX;
      } else {
        // Silky slow cinema camera glide (~750ms time constant)
        const alpha = 1 - Math.exp(-dt * 0.0036);
        s2CamX += (targetCamX - s2CamX) * alpha;
      }
      s2World.style.transform = `translate3d(${-s2CamX.toFixed(2)}px, 0, 0)`;

      const rect = wrap.getBoundingClientRect();
      if (rect.width < 10) return;
      ctx.clearRect(0, 0, worldW, s2World.offsetHeight);

      // Smooth ease-in-out orb progress within the current 2.15s beat
      const rawBeatT = s2PinnedBeat !== null ? ((now * 0.00045) % 1) : (elapsed % BEAT_MS) / BEAT_MS;
      const clampedT = Math.max(0, Math.min(1, (rawBeatT - 0.08) / 0.82));
      const smoothT = clampedT * clampedT * (3 - 2 * clampedT);

      S2_WIRES.forEach((wire) => {
        const p0 = getPortPos(wrap, wire.from, rect);
        const p3 = getPortPos(wrap, wire.to, rect);
        if (!p0 || !p3) return;

        const dx = Math.max(24, Math.abs(p3.x - p0.x) * 0.52);
        const p1 = { x: p0.x + dx, y: p0.y };
        const p2 = { x: p3.x - dx, y: p3.y };

        const isActive = beat.activeWires.includes(wire.id);
        const isLit = beat.litWires.includes(wire.id);

        ctx.beginPath();
        ctx.moveTo(p0.x, p0.y);
        ctx.bezierCurveTo(p1.x, p1.y, p2.x, p2.y, p3.x, p3.y);

        if (isActive) {
          ctx.strokeStyle = wire.color;
          ctx.lineWidth = 2;
        } else if (isLit) {
          ctx.strokeStyle = 'rgba(16, 185, 129, 0.52)';
          ctx.lineWidth = 1.6;
        } else {
          ctx.strokeStyle = 'rgba(168, 192, 184, 0.35)';
          ctx.lineWidth = 1.3;
        }
        ctx.stroke();

        if (isActive && !reduced) {
          const pt = cubicPoint(p0, p1, p2, p3, smoothT);
          // Soft outer halo
          ctx.beginPath();
          ctx.arc(pt.x, pt.y, 7.5, 0, Math.PI * 2);
          ctx.fillStyle = wire.color === '#2563eb' ? 'rgba(37, 99, 235, 0.18)' : 'rgba(5, 150, 105, 0.2)';
          ctx.fill();

          // Crisp core orb
          ctx.beginPath();
          ctx.arc(pt.x, pt.y, 3.8, 0, Math.PI * 2);
          ctx.fillStyle = wire.color;
          ctx.fill();
          ctx.lineWidth = 1.5;
          ctx.strokeStyle = '#ffffff';
          ctx.stroke();
        }
      });
    };

    const updateScene1Demo = (now: number) => {
      if (!s1Stage) return;
      const dt = Math.min(64, Math.max(1, now - s1LastFrame));
      s1LastFrame = now;

      const totalCycle = 3 * S1_ACT_MS;
      const elapsed = (now - s1StartTime) % totalCycle;
      const autoAct = Math.min(2, Math.floor(elapsed / S1_ACT_MS));
      const actIdx = s1PinnedAct !== null ? s1PinnedAct : reduced ? 2 : autoAct;
      const actProgress = s1PinnedAct !== null ? 0.55 : (elapsed % S1_ACT_MS) / S1_ACT_MS;

      if (s1AppliedAct !== actIdx) {
        s1AppliedAct = actIdx;
        s1ClickedInAct = false;
        s1Acts.forEach((el, idx) => {
          el.classList.toggle('is-active', idx === actIdx);
        });
        s1StepBtns.forEach((btn, idx) => {
          btn.classList.toggle('active', idx === actIdx);
        });
      }

      if (s1Cursor) {
        if (reduced) {
          s1Cursor.style.opacity = '0';
          return;
        }
        s1Cursor.style.opacity = '1';
        const stageRect = s1Stage.getBoundingClientRect();
        const targetEl = s1Stage.querySelector<HTMLElement>(`[data-s1-target="${actIdx}"]`);

        let tx = stageRect.width * 0.55;
        let ty = stageRect.height * 0.55;
        if (targetEl && stageRect.width > 20) {
          const r = targetEl.getBoundingClientRect();
          tx = r.left - stageRect.left + r.width * 0.58;
          ty = r.top - stageRect.top + r.height * 0.58;
        }

        const alpha = 1 - Math.exp(-dt * 0.0055);
        s1CurX += (tx - s1CurX) * alpha;
        s1CurY += (ty - s1CurY) * alpha;

        // Trigger a gentle click ripple around 62% through each act
        const clicking = s1PinnedAct === null && actProgress > 0.62 && actProgress < 0.76;
        if (clicking && !s1ClickedInAct && s1Ripple) {
          s1ClickedInAct = true;
          s1Ripple.classList.remove('pop');
          void s1Ripple.offsetWidth;
          s1Ripple.classList.add('pop');
        }
        if (targetEl) {
          targetEl.classList.toggle('is-clicked', clicking);
        }

        const scale = clicking ? 0.88 : 1;
        s1Cursor.style.transform = `translate3d(${s1CurX.toFixed(1)}px, ${s1CurY.toFixed(1)}px, 0) scale(${scale})`;
      }
    };

    const refreshActiveCanvas = () => {
      cancelAnimationFrame(raf);
      if (currentScene === 0 && GW_WIRES[currentGwMode]) {
        const { wrap, canvas, ctx } = getGwSurface(currentGwMode);
        requestAnimationFrame(() => {
          resizeSurface(wrap, canvas, ctx);
          tick(performance.now());
        });
      } else if (currentScene === 1) {
        requestAnimationFrame(() => {
          tick(performance.now());
        });
      } else if (currentScene === 2) {
        const { wrap, canvas, ctx } = getS2Surface();
        requestAnimationFrame(() => {
          resizeSurface(wrap, canvas, ctx);
          tick(performance.now());
        });
      }
    };

    const tick = (now: number) => {
      if (currentScene === 0 && GW_WIRES[currentGwMode]) {
        drawGwWires(now);
      } else if (currentScene === 1) {
        updateScene1Demo(now);
      } else if (currentScene === 2) {
        drawScene2Parity(now);
      }

      const needsLoop =
        visible &&
        !reduced &&
        ((currentScene === 0 && Boolean(GW_WIRES[currentGwMode])) || currentScene === 1 || currentScene === 2);
      if (needsLoop) {
        raf = requestAnimationFrame(tick);
      }
    };

    const applyGwMode = (mIdx: number) => {
      currentGwMode = mIdx;
      gwBtns.forEach((b, i) => {
        const active = i === mIdx;
        b.classList.toggle('active', active);
        b.setAttribute('aria-selected', String(active));
      });
      gwPanels.forEach((p, i) => {
        p.hidden = i !== mIdx;
      });
      if (gwDescEl && gwDescs[mIdx]) {
        gwDescEl.textContent = gwDescs[mIdx];
      }
      refreshActiveCanvas();
    };

    const setScene = (index: number) => {
      currentScene = index;
      root.setAttribute('data-active-scene', String(index));

      leftTriggers.forEach((btn, i) => {
        const active = i === index;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-pressed', String(active));
      });

      topTabs.forEach((tab, i) => {
        const active = i === index;
        tab.classList.toggle('active', active);
        tab.setAttribute('aria-selected', String(active));
      });

      panels.forEach((panel, i) => {
        panel.hidden = i !== index;
      });

      badges.forEach((b, i) => {
        b.hidden = i !== index;
      });

      if (index === 1) {
        s1PinnedAct = null;
        s1AppliedAct = -1;
        s1StartTime = performance.now();
        s1LastFrame = s1StartTime;
      } else if (index === 2) {
        s2PinnedBeat = null;
        s2AppliedBeat = -1;
        s2CamX = 0;
        s2StartTime = performance.now();
        s2LastFrame = s2StartTime;
      }

      refreshActiveCanvas();
    };

    s1StepBtns.forEach((btn, idx) => {
      btn.addEventListener('click', () => {
        s1PinnedAct = idx;
        s1AppliedAct = -1;
        updateScene1Demo(performance.now());
      });
    });

    s1Stage?.addEventListener('pointerleave', () => {
      if (s1PinnedAct !== null) {
        s1StartTime = performance.now() - s1PinnedAct * S1_ACT_MS;
        s1PinnedAct = null;
      }
    });

    s2StepBtns.forEach((btn, sIdx) => {
      btn.addEventListener('click', () => {
        const targetBeat = STEP_TO_BEAT[sIdx] ?? 0;
        s2PinnedBeat = targetBeat;
        s2AppliedBeat = -1;
        if (reduced) {
          drawScene2Parity(performance.now());
        }
      });
    });

    s2Viewport?.addEventListener('pointerleave', () => {
      if (s2PinnedBeat !== null) {
        s2StartTime = performance.now() - s2PinnedBeat * BEAT_MS;
        s2PinnedBeat = null;
      }
    });

    gwBtns.forEach((btn, mIdx) => {
      btn.addEventListener('click', () => {
        applyGwMode(mIdx);
      });
    });

    leftTriggers.forEach((btn, idx) => {
      btn.addEventListener('click', () => setScene(idx));
      btn.addEventListener('pointerenter', () => setScene(idx));
    });

    topTabs.forEach((tab, idx) => {
      tab.addEventListener('click', () => setScene(idx));
    });

    const ro = new ResizeObserver(() => refreshActiveCanvas());
    ro.observe(root);

    const io = new IntersectionObserver(
      (entries) => {
        visible = Boolean(entries[0]?.isIntersecting);
        if (!visible) cancelAnimationFrame(raf);
        else refreshActiveCanvas();
      },
      { threshold: 0.05 }
    );
    io.observe(root);

    applyGwMode(0);
    setScene(0);
  });
</script>


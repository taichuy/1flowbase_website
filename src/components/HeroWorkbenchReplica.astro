  /* =====================================================================
     SCENE 1: 3-Act Authentic UI Operation Animation (Full-Width, Zero Crowding)
     Act 0: 主数据源 (095705519.png)
     Act 1: TSX 编辑器 + UI 模式 (5155c1d0...png)
     Act 2: 企业 Wiki 知识库 (6bc0a7...jpeg)
     ===================================================================== */
  .s1-demo-shell {
    min-height: 438px;
    padding: 12px 14px;
    box-sizing: border-box;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 10px;
  }

  .s1-stage {
    position: relative;
    flex: 1;
    min-height: 348px;
    border-radius: 13px;
    border: 1px solid #ddece6;
    background: #f6fbf9;
    overflow: hidden;
  }

  .s1-act {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateY(6px);
    pointer-events: none;
    transition: opacity 0.5s ease, transform 0.5s ease;
    display: flex;
    flex-direction: column;
  }

  .s1-act.is-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
    z-index: 2;
  }

  /* Smooth Animated Pointer + Click Ripple */
  .s1-cursor {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 15;
    pointer-events: none;
    will-change: transform;
    filter: drop-shadow(0 4px 8px rgb(15 23 42 / 22%));
  }

  .s1-ripple {
    position: absolute;
    left: -10px;
    top: -10px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid #10b981;
    opacity: 0;
    transform: scale(0.3);
  }

  .s1-ripple.pop {
    animation: s1-click-ring 0.65s ease-out forwards;
  }

  @keyframes s1-click-ring {
    0% { opacity: 0.95; transform: scale(0.35); }
    100% { opacity: 0; transform: scale(1.75); }
  }


---

<figure class="arch" aria-labelledby="arch-title" data-tabs>
  <figcaption class="arch-heading">
    <div class="arch-intro">
      <span class="arch-eyebrow">{heading.eyebrow}</span>
      <h2 id="arch-title">{heading.title}</h2>
      <p>{heading.subtitle}</p>
    </div>
    <div class="arch-tabs" role="tablist" aria-label={heading.tabs}>
      {views.map((view, i) => (
        <button
          type="button"
          id={`arch-tab-${i}`}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`arch-panel-${i}`}
          tabindex={i === 0 ? 0 : -1}
          data-tab={i}
        >
          {view.tab}
        </button>
      ))}
    </div>
  </figcaption>

  {views.map((view, i) => (
    <div
      class="arch-panel"
      id={`arch-panel-${i}`}
      role="tabpanel"
      aria-labelledby={`arch-tab-${i}`}
      tabindex="0"
      hidden={i !== 0}
      data-panel={i}
    >
      <div class="arch-grid" style={`--layers:${view.layers.length}`}>
        <ol class="arch-layers">
          {view.layers.map((layer, n) => (
            <li class:list={['arch-layer', layer.tone && `tone-${layer.tone}`]}>
              <div class="arch-layer-label">
                <span>L{n + 1}</span>
                <strong>{layer.name}</strong>
                <em>{layer.role}</em>
              </div>
              <div class="arch-layer-items" style={`--cols:${layer.items.length}`}>
                {layer.items.map(([title, detail]) => (
                  <div class="arch-node">
                    <strong>{title}</strong>
                    <span>{detail}</span>
                  </div>
                ))}
              </div>
            </li>
          ))}
        </ol>
        <aside class="arch-cross" aria-label={view.crossName}>
          <span class="arch-cross-title">{view.crossName}</span>
          {view.cross.map(([title, detail]) => (
            <div class="arch-node">
              <strong>{title}</strong>
              <span>{detail}</span>
            </div>
          ))}
        </aside>
      </div>
      <p class="arch-note">{view.note}</p>
    </div>
  ))}
</figure>

<style>
  .arch {
    margin: 0;
    padding: 32px;
    background: linear-gradient(155deg, #f3fcf8 0%, #ffffff 55%, #f4faff 100%);
    border: 1px solid #d4eae2;
    border-radius: 22px;
    box-shadow: 0 22px 60px rgb(4 61 49 / 6%);
    color: #08231c;
  }

  .arch-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 24px;
  }

  .arch-eyebrow {
    display: inline-block;
    font: 700 11px/1.4 var(--font-mono);
    letter-spacing: 0.1em;
    color: #059669;
    margin-bottom: 6px;
  }

  .arch-intro h2 {
    font-size: clamp(22px, 2.5vw, 30px);
    font-weight: 780;
    letter-spacing: -0.035em;
    line-height: 1.22;
    margin: 0 0 8px;
    color: #08231c;
  }

  .arch-intro p {
    margin: 0;
    font-size: 14px;
    line-height: 1.65;
    color: #4f6962;
    max-width: 680px;
  }

  .arch-tabs {
    display: inline-flex;
    flex-shrink: 0;
    padding: 4px;
    background: #e6f5ef;
    border: 1px solid #cde7dc;
    border-radius: 999px;
  }

  .arch-tabs button {
    min-height: 38px;
    white-space: nowrap;
    padding: 6px 16px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: #3a5c52;
    font: 650 13px/1.4 var(--font-sans);
    cursor: pointer;
    transition: all 0.16s ease;
  }

  .arch-tabs button[aria-selected='true'] {
    background: #064e3b;
    color: #ffffff;
    box-shadow: 0 4px 12px rgb(6 78 59 / 20%);
  }

  .arch-tabs button:focus-visible {
    outline: 2px solid #059669;
    outline-offset: 2px;
  }

  .arch-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 225px;
    gap: 12px;
  }

  .arch-layers {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .arch-layer {
    position: relative;
    display: grid;
    grid-template-columns: 142px minmax(0, 1fr);
    gap: 10px;
    padding: 10px;
    background: #ffffff;
    border: 1px solid #d7ebe3;
    border-radius: 12px;
  }

  .arch-layer:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 71px;
    bottom: -9px;
    width: 1px;
    height: 8px;
    background: #9dd4c0;
  }

  .arch-layer-label {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    padding: 4px 8px;
    border-right: 1px solid #e5f2ed;
  }

  .arch-layer-label span {
    font: 700 10.5px/1.4 var(--font-mono);
    color: #059669;
  }

  .arch-layer-label strong {
    font-size: 13.5px;
    font-weight: 720;
    line-height: 1.3;
  }

  .arch-layer-label em {
    font: normal 11.5px/1.4 var(--font-sans);
    color: #56736a;
    overflow-wrap: anywhere;
  }

  .arch-layer-items {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 8px;
  }

  .arch-node {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    padding: 10px 12px;
    background: #f6fcfa;
    border: 1px solid #e1f1eb;
    border-radius: 9px;
  }

  .arch-node strong {
    font-size: 12.5px;
    font-weight: 700;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .arch-node span {
    font-size: 11.5px;
    line-height: 1.5;
    color: #4f6b63;
    overflow-wrap: anywhere;
  }

  .tone-dark {
    background: linear-gradient(135deg, #064e3b 0%, #075e46 100%);
    border-color: #064e3b;
    color: #ffffff;
  }

  .tone-dark .arch-layer-label {
    border-color: rgb(255 255 255 / 16%);
  }

  .tone-dark .arch-layer-label span {
    color: #64e3b1;
  }

  .tone-dark .arch-layer-label em {
    color: #bde8d7;
  }

  .tone-dark .arch-node {
    background: rgb(255 255 255 / 10%);
    border-color: rgb(255 255 255 / 16%);
  }

  .tone-dark .arch-node span {
    color: #d4f3e7;
  }

  .tone-soft {
    background: #e8f8f1;
    border-color: #bfe8d7;
  }

  .tone-soft .arch-node {
    background: #ffffff;
    border-color: #d3eee2;
  }

  .tone-dashed {
    background: rgb(255 255 255 / 65%);
    border-style: dashed;
    border-color: #96d2bc;
  }

  .tone-dashed .arch-node {
    background: #ffffff;
  }

  .arch-cross {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px;
    background: repeating-linear-gradient(135deg, #eef9f4 0 8px, #f7fcfa 8px 16px);
    border: 1px dashed #96d2bc;
    border-radius: 12px;
  }

  .arch-cross-title {
    font: 700 12px/1.4 var(--font-sans);
    color: #065f46;
    padding: 2px 2px 4px;
  }

  .arch-cross .arch-node {
    flex: 1;
    justify-content: center;
    background: #ffffff;
  }

  .arch-note {
    margin: 16px 0 0;
    font-size: 12px;
    line-height: 1.65;
    color: #56726a;
  }

  @media (max-width: 960px) {
    .arch-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .arch-cross {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .arch-cross-title {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 780px) {
    .arch-heading {
      flex-direction: column;
      align-items: flex-start;
    }

    .arch-layer-items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .arch {
      padding: 20px 14px;
    }

    .arch-layer {
      grid-template-columns: minmax(0, 1fr);
    }

    .arch-layer-label {
      flex-direction: row;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 6px;

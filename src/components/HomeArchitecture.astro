---
import type { Locale } from '../config';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const zh = lang === 'zh';

type Item = [string, string];
interface Layer {
  name: string;
  role: string;
  items: Item[];
  tone?: 'dark' | 'soft' | 'dashed';
}
interface View {
  tab: string;
  layers: Layer[];
  crossName: string;
  cross: Item[];
  note: string;
}

const heading = zh
  ? {
      eyebrow: 'ARCHITECTURE',

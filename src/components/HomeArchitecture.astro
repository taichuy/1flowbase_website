      tabs: '切换架构视图',
    }
  : {
      eyebrow: 'ARCHITECTURE',
      title: 'Two layered views: how apps grow on top, and how the Rust core runs underneath',
      subtitle: 'One self-hosted foundation connecting humans and Super-agents above while governing context, events, and permissions below.',
      tabs: 'Switch architecture view',
    };


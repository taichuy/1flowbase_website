---
import { getCollection } from 'astro:content';
import { localePath, type Locale } from '../config';
import { blogTopics, topicOrder } from '../data/blog';
import Icon from './RuntimeIcon.astro';
import '../styles/blog.css';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const posts = await getCollection('blog', ({ data }) => data.lang === lang && !data.draft);
const topics = topicOrder.filter(topic => posts.some(post => post.data.slug === blogTopics[lang][topic].featured));
---
<section class="home-section home-guides" id="guides">
  <div class="site-container">
    <div class="section-intro"><span class="micro-label">{lang === 'zh' ? '实践指南' : 'Practical guides'}</span><h2>{lang === 'zh' ? '带着一个问题，找到下一步。' : 'Find a next step for your application.'}</h2><p>{lang === 'zh' ? '从适用场景和验证清单开始，再决定要构建什么。' : 'Start with a use case and an evaluation checklist before choosing what to build.'}</p></div>
    <div class="blog-paths">{topics.map((topic, index) => <a class="blog-path-card" href={localePath(lang, `/blog/${blogTopics[lang][topic].featured}/`)}><span class="blog-path-number">0{index + 1}</span><h3>{blogTopics[lang][topic].title}</h3><span>{blogTopics[lang][topic].description}</span><Icon name="arrow" /></a>)}</div>
    <a class="text-link" href={localePath(lang, '/blog/')}>{lang === 'zh' ? '浏览全部文章' : 'Browse all articles'}<Icon name="arrow" /></a>
  </div>
</section>

---
import { SITE, type Locale, localePath } from '../config';
import { homeCopy } from '../data/home';
import Icon from './RuntimeIcon.astro';
import HeroWorkbenchReplica from './HeroWorkbenchReplica.astro';
import HomeVisualSections from './HomeVisualSections.astro';
import HomeArchitecture from './HomeArchitecture.astro';
import '../styles/home.css';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const c = homeCopy[lang];

const commands = [
  {
    name: 'Linux / macOS',
    label: 'bash',
    url: 'https://raw.githubusercontent.com/taichuy/1flowbase/main/scripts/shell/docker-deploy.sh',
    command: 'curl -fsSL https://raw.githubusercontent.com/taichuy/1flowbase/main/scripts/shell/docker-deploy.sh | sh',
  },
  {
    name: 'PowerShell',
    label: 'powershell',
    url: 'https://raw.githubusercontent.com/taichuy/1flowbase/main/scripts/powershell/docker-deploy.ps1',
    command: 'irm https://raw.githubusercontent.com/taichuy/1flowbase/main/scripts/powershell/docker-deploy.ps1 | iex',
  },
  {
    name: 'Windows CMD',
    label: 'cmd',
    url: 'https://raw.githubusercontent.com/taichuy/1flowbase/main/scripts/powershell/docker-deploy.ps1',
    command:
      'powershell -NoProfile -ExecutionPolicy Bypass -Command "irm https://raw.githubusercontent.com/taichuy/1flowbase/main/scripts/powershell/docker-deploy.ps1 | iex"',
  },
];

const chipIcons = ['route', 'database', 'layout'];
---

<div class="runtime-home" data-locale={lang}>
  <!-- 1. SPACIOUS HERO: CONCISE LEFT HIERARCHY + REAL WORKBENCH CANVAS REPLICA -->
  <section class="runtime-hero">
    <div class="hero-ambient-mint" aria-hidden="true"></div>
    <div class="hero-ambient-sky" aria-hidden="true"></div>

    <div class="site-container hero-split">
      <div class="hero-copy">
        <h1>
          <span class="hero-h1-dark">{c.headlineDark}</span>{lang === 'en' ? ' ' : ''}<span class="hero-h1-accent">{c.headlineAccent}</span>
        </h1>

        <p class="hero-subtitle">{c.subtitle}</p>

        <p class="hero-lead">
          {c.leadBold}{c.leadBody}
        </p>

        <!-- Interactive scenario pills synchronized 1:1 with the right workbench tabs -->
        <div class="hero-route-pills" role="group" aria-label={lang === 'zh' ? '点击切换右侧界面示例' : 'Switch interactive workbench preview'}>
          {c.heroChips.map(([left, right], idx) => (
            <button
              type="button"
              class:list={['route-pill', idx === 0 && 'is-active']}
              data-hero-trigger={idx}
              aria-pressed={idx === 0 ? 'true' : 'false'}
            >
              <span class="rp-ico"><Icon name={chipIcons[idx]} /></span>
              <b>{left}</b>
              <i aria-hidden="true">→</i>
              <em>{right}</em>
            </button>
          ))}
        </div>

        <!-- Preserved dual install buttons -->
        <div class="hero-actions">
          <div class="local-download">
            <a class="button-primary download-main" href="https://github.com/taichuy/1flowbase/releases/latest" data-local-install>
              <span data-download-label>{c.primary}</span>
            </a>
            <details class="download-selector" data-download-selector>
              <summary aria-label={lang === 'zh' ? '选择其他系统安装包' : 'Choose another platform'}>
                <Icon name="chevronDown" />
              </summary>
              <div class="download-menu">
                <p>{lang === 'zh' ? '选择系统和处理器' : 'Choose your system and processor'}</p>
                {[
                  ['windows', 'x64', 'Windows · x64', '1flowbase-windows-x64.zip'],
                  ['macos', 'arm64', 'macOS · Apple Silicon (arm64)', '1flowbase-macos-arm64.tar.gz'],
                  ['macos', 'x64', 'macOS · Intel (x64)', '1flowbase-macos-x64.tar.gz'],
                  ['linux', 'x64', 'Linux · x64', '1flowbase-linux-x64.tar.gz'],
                  ['linux', 'arm64', 'Linux · arm64', '1flowbase-linux-arm64.tar.gz'],
                ].map(([os, arch, label, filename]) => (
                  <a
                    href={`https://github.com/taichuy/1flowbase/releases/latest/download/${filename}`}
                    data-download-os={os}
                    data-download-arch={arch}
                  >
                    <span>{label}</span>
                    <Icon name="arrow" />
                  </a>
                ))}
                <a class="all-releases" href="https://github.com/taichuy/1flowbase/releases/latest">
                  {lang === 'zh' ? '查看全部发行版本' : 'View all releases'} ↗
                </a>
              </div>
            </details>
          </div>

          <a class="button-secondary" href="#get-started">
            <span>{c.secondary}</span>
            <Icon name="arrow" />
          </a>
        </div>

        <p class="hero-version-note">{c.versionNote}</p>
      </div>

      <div class="hero-visual-col">
        <HeroWorkbenchReplica lang={lang} />
      </div>
    </div>
  </section>

  <!-- 2. BRAND STRIP + 5 GRAPHICAL UI REPLICA SECTIONS -->
  <HomeVisualSections lang={lang} />

  <!-- 3. PRESERVED & UPDATED ARCHITECTURE DUAL-VIEW -->
  <section class="home-section architecture-section" id="architecture" aria-labelledby="arch-title">
    <div class="site-container">
      <HomeArchitecture lang={lang} />
    </div>
  </section>

  <!-- 4. CONCISE COMPARISON TABLE -->
  <section class="home-section compare-section" id="comparison">
    <div class="site-container">
      <div class="section-intro">
        <span class="micro-label">{c.comparison.eyebrow}</span>
        <h2>{c.comparison.title}</h2>
        <p>{c.comparison.subtitle}</p>
      </div>

      <div class="compare-table-card">
        <table class="compare-table">
          <thead>
            <tr>
              <th scope="col">{c.comparison.headers[0]}</th>
              <th scope="col">{c.comparison.headers[1]}</th>
              <th scope="col" class="accent-col">{c.comparison.headers[2]}</th>
            </tr>
          </thead>
          <tbody>
            {c.comparison.rows.map(([tool, category, goodAt, inOneFlow]) => (
              <tr>
                <td class="tool-cell">
                  <strong>{tool}</strong>
                  <span>{category}</span>
                </td>
                <td class="boundary-cell">{goodAt}</td>
                <td class="solution-cell">{inOneFlow}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 5. CRISP CLI / DOCKER INSTALL -->
  <section class="home-section install-section" id="get-started">
    <div class="site-container">
      <div class="section-intro">
        <span class="micro-label">{c.install.eyebrow}</span>
        <h2>{c.install.title}</h2>
        <p>{c.install.text}</p>
      </div>

      <div class="install-card" data-tabs>
        <div class="install-tabs" role="tablist" aria-label={lang === 'zh' ? '选择操作系统' : 'Choose operating system'}>
          {commands.map((item, i) => (
            <button
              type="button"
              id={`install-tab-${i}`}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`install-panel-${i}`}
              tabindex={i === 0 ? 0 : -1}
              data-tab={i}
            >
              {item.name}
            </button>
          ))}
        </div>

        {commands.map((item, i) => (
          <div hidden={i !== 0} id={`install-panel-${i}`} role="tabpanel" aria-labelledby={`install-tab-${i}`} data-panel={i}>
            <div class="cmd-bar">
              <code>$ {item.command}</code>
              <button
                type="button"
                class="copy-command"
                data-copy-command={item.command}
                data-copy-label={c.install.copy}
                data-copied-label={c.install.copied}
                data-copy-error={c.install.copyError}
              >
                {c.install.copy}
              </button>
            </div>
            <div class="cmd-links">
              <a href={localePath(lang, '/docs/')}>{c.install.link} →</a>
              <a href={item.url} target="_blank" rel="noreferrer">{c.install.reviewScript} ↗</a>
            </div>
          </div>
        ))}
        <p class="install-note">{c.install.note}</p>
        <p class="copy-status" role="status" aria-live="polite"></p>
      </div>
    </div>
  </section>

  <!-- 6. CONCISE FAQ -->
  <section class="home-section faq-section" id="faq">
    <div class="site-container faq-container">
      <div class="section-intro centered">
        <span class="micro-label">{c.faqEyebrow}</span>
        <h2>{c.faqTitle}</h2>
      </div>

      <div class="faq-list">
        {c.faqs.map(([q, a], idx) => (
          <details class="faq-item" open={idx === 0}>
            <summary>
              <span>{q}</span>
              <span class="faq-toggle" aria-hidden="true"></span>
            </summary>
            <div class="faq-answer">
              <p>{a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. MAGPIE-STYLE CLEAN CLOSING + PLATFORM CARDS -->
  <section class="closing-banner">
    <div class="site-container closing-inner">
      <img src="/favicon.svg" alt="" width="52" height="52" class="closing-mark" />
      <h2>{c.closing.title}</h2>
      <p>{c.closing.sub}</p>

      <div class="closing-actions">
        <a class="button-primary" href="#get-started">
          <span>{c.closing.ctaPrimary}</span>
          <Icon name="arrow" />
        </a>
        <a class="button-secondary" href={SITE.repository} target="_blank" rel="noreferrer">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="gh-mini">
            <path d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.5-.28-5.13-1.25-5.13-5.56 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.15a10.8 10.8 0 0 1 5.63 0c2.15-1.46 3.1-1.15 3.1-1.15.61 1.55.23 2.7.11 2.98.72.79 1.16 1.79 1.16 3.02 0 4.32-2.64 5.27-5.15 5.55.4.35.76 1.03.76 2.08v3.11c0 .3.2.65.77.54A11.25 11.25 0 0 0 12 .75Z" />
          </svg>
          <span>{c.closing.ctaSecondary}</span>
        </a>
      </div>

      <div class="os-cards">
        <a href="https://github.com/taichuy/1flowbase/releases/latest">
          <div><strong>macOS</strong><span>Apple Silicon · Intel</span></div>
          <em>.tar.gz</em>
        </a>
        <a href="https://github.com/taichuy/1flowbase/releases/latest">
          <div><strong>Windows</strong><span>x64 · PowerShell</span></div>
          <em>.zip</em>
        </a>
        <a href="https://github.com/taichuy/1flowbase/releases/latest">
          <div><strong>Linux & Docker</strong><span>x64 · ARM64</span></div>
          <em>Compose</em>
        </a>
      </div>
    </div>
  </section>
</div>

<script>
  const installLink = document.querySelector<HTMLAnchorElement>('[data-local-install]');
  const downloadSelector = document.querySelector<HTMLDetailsElement>('[data-download-selector]');
  if (installLink && downloadSelector) {
    const isZh = document.querySelector('.runtime-home')?.getAttribute('data-locale') === 'zh';
    let matched = false;
    installLink.addEventListener('click', (event) => {
      if (!matched) {
        event.preventDefault();
        downloadSelector.open = true;
        downloadSelector.querySelector<HTMLElement>('summary')?.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (
        event.target instanceof Node &&
        !downloadSelector.contains(event.target) &&
        event.target !== installLink &&
        !installLink.contains(event.target)
      ) {
        downloadSelector.open = false;
      }
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && downloadSelector.open) {
        downloadSelector.open = false;
        downloadSelector.querySelector<HTMLElement>('summary')?.focus();
      }
    });
    void (async () => {
      const ua = navigator.userAgent;
      const uaData = (
        navigator as Navigator & {
          userAgentData?: {
            platform?: string;
            getHighEntropyValues?: (hints: string[]) => Promise<{ architecture?: string; bitness?: string }>;
          };
        }
      ).userAgentData;
      const platform = uaData?.platform || navigator.platform || ua;
      const mobile = /Android|iPhone|iPad|iPod/i.test(ua) || (/Mac/i.test(platform) && navigator.maxTouchPoints > 1);
      const os = mobile ? '' : /Win/i.test(platform) ? 'windows' : /Mac/i.test(platform) ? 'macos' : /Linux/i.test(platform) ? 'linux' : '';
      let arch = '';
      try {
        const hints = await uaData?.getHighEntropyValues?.(['architecture', 'bitness']);
        if (hints?.bitness === '64') {
          if (/arm/i.test(hints.architecture ?? '')) arch = 'arm64';
          else if (/x86/i.test(hints.architecture ?? '')) arch = 'x64';
        }
      } catch {
        /* Browser does not expose processor hints. */
      }
      if (!arch && (os === 'linux' || os === 'windows')) {
        const systemInfo = `${platform} ${ua}`;
        if (/aarch64|arm64/i.test(systemInfo)) arch = 'arm64';
        else if (/x86_64|x64|amd64|win64|wow64/i.test(systemInfo)) arch = 'x64';
      }
      const match = downloadSelector.querySelector<HTMLAnchorElement>(`[data-download-os="${os}"][data-download-arch="${arch}"]`);
      const label = installLink.querySelector<HTMLElement>('[data-download-label]');
      if (match && label) {
        const system = match.querySelector('span')?.textContent ?? '';
        installLink.href = match.href;
        label.textContent = isZh ? `下载 ${system}` : `Download ${system}`;
        matched = true;
      } else if (label) {
        label.textContent = isZh ? '本地安装' : 'Local install';
      }
    })();
  }

  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>(':scope [role="tablist"] [data-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>(':scope > [data-panel]'));
    if (!tabs.length || !panels.length) return;
    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
      });
      panels.forEach((panel, i) => {
        panel.hidden = i !== index;
      });
      if (focus) tabs[index]?.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (event) => {
        let next = i;
        if (event.key === 'ArrowRight') next = (i + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        select(next, true);
      });
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-copy-command]').forEach((button) => {
    let timer: ReturnType<typeof setTimeout>;
    button.addEventListener('click', async () => {
      const status = button.closest('.install-card')?.querySelector('.copy-status');
      try {
        await navigator.clipboard.writeText(button.dataset.copyCommand ?? '');
        if (status) status.textContent = button.dataset.copiedLabel ?? 'Copied';
        clearTimeout(timer);
        timer = setTimeout(() => {
          if (status) status.textContent = '';
        }, 3500);
      } catch {
        if (status) status.textContent = button.dataset.copyError ?? 'Select manually to copy';
      }
    });
  });
</script>

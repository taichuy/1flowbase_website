---
import { Image } from 'astro:assets';
import workflow from '../assets/product/workflow-editor.png';
import execution from '../assets/product/execution-logs.jpeg';
import api from '../assets/product/api-publish.jpeg';
import { SITE, type Locale, localePath } from '../config';
import { homeCopy } from '../data/home';
import Icon from './RuntimeIcon.astro';
import HomeGuides from './HomeGuides.astro';
import HeroFlow from './HeroFlow.astro';
import HeroValue from './HeroValue.astro';
import '../styles/home.css';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const c = homeCopy[lang];
const screenshots = [workflow, execution, api];
const commands = [
  { name: 'Linux / macOS', label: 'bash', url: 'https://raw.githubusercontent.com/taichuy/1flowbase/main/scripts/shell/docker-deploy.sh', command: 'curl -fsSL https://raw.githubusercontent.com/taichuy/1flowbase/main/scripts/shell/docker-deploy.sh | sh' },
  { name: 'PowerShell', label: 'powershell', url: 'https://raw.githubusercontent.com/taichuy/1flowbase/main/scripts/powershell/docker-deploy.ps1', command: 'irm https://raw.githubusercontent.com/taichuy/1flowbase/main/scripts/powershell/docker-deploy.ps1 | iex' },
  { name: 'Windows CMD', label: 'cmd', url: 'https://raw.githubusercontent.com/taichuy/1flowbase/main/scripts/powershell/docker-deploy.ps1', command: 'powershell -NoProfile -ExecutionPolicy Bypass -Command "irm https://raw.githubusercontent.com/taichuy/1flowbase/main/scripts/powershell/docker-deploy.ps1 | iex"' },
];
---
<div class="runtime-home" data-locale={lang}>
  <section class="runtime-hero">
    <div class="site-container hero-grid hero-stack">
      <div class="hero-message">
        <span class="micro-label"><span class="status-dot"></span>{c.badge}</span>
        <h1>{c.headline.map((line, i) => <span class:list={[i === 2 && 'accent-line']}>{line}{lang === 'en' && i < 2 ? '\u00a0' : ''}</span>)}</h1>
        <p class="hero-lead">{c.lead}</p>
        <div class="hero-actions"><a class="button-primary" href="#get-started">{c.primary}<Icon name="arrow" /></a><a class="button-secondary" href={SITE.repository}>{c.secondary}<span class="external-arrow" aria-hidden="true"><Icon name="arrowUpRight" /></span></a></div>
        <ul class="trust-list">{c.trust.map(item => <li><span aria-hidden="true">✓</span>{item}</li>)}</ul>
      </div>
      <HeroValue lang={lang} />
    </div>
    <div class="site-container protocol-strip"><span>{c.protocolLabel}</span><div><span>Anthropic <b>Messages</b></span><i></i><span>OpenAI <b>Chat Completions</b></span><i></i><span>OpenAI <b>Responses</b></span></div></div>
  </section>

  <section class="home-section architecture-section" aria-labelledby="architecture-title">
    <div class="site-container">
      <div class="architecture-heading"><div><span class="micro-label">{lang === 'zh' ? '从对话到应用' : 'FROM CONVERSATIONS TO APPLICATIONS'}</span><h2 id="architecture-title">{lang === 'zh' ? '每一步，都连接在一起。' : 'Every step, connected.'}</h2></div><p>{lang === 'zh' ? '点选方块，了解每一层如何工作。' : 'Select a card to explore how each layer works.'}</p></div>
      <HeroFlow lang={lang} />
    </div>
  </section>

  <section class="home-section capabilities-section" id="capabilities">
    <div class="site-container"><div class="section-intro"><span class="micro-label">{c.valueEyebrow}</span><h2>{c.valueTitle}</h2><p>{c.valueText}</p></div>
      <div class="capability-grid">{c.features.map(([icon,tag,title,description],i) => <article class="capability-card"><div class="capability-top"><span class="feature-icon"><Icon name={icon}/></span><span>0{i+1}</span></div><span class="card-category">{tag}</span><h3>{title}</h3><p>{description}</p></article>)}</div>
      <a class="text-link" href={localePath(lang,'/features/')}>{lang === 'zh' ? '了解全部产品能力' : 'Explore all capabilities'} <Icon name="arrow"/></a>
    </div>
  </section>

  <section class="home-section composition-section"><div class="site-container composition-grid"><div class="section-intro"><span class="micro-label">{c.composeEyebrow}</span><h2 class="preserve-lines">{c.composeTitle}</h2><p>{c.composeText}</p><p class="small-note">{c.composeNote}</p></div><div class="composition-flow"><div class="flow-label"><span></span>{c.flowInput}</div>{c.flow.map(([num,title,model],i) => <div class:list={['flow-node',i === 1 && 'worker-node']}><span class="flow-number">{num}</span><div><strong>{title}</strong><span>{model}</span></div><Icon name={i===1 ? 'code' : 'spark'}/></div>)}<div class="flow-result"><Icon name="route"/>{c.flowOutput}<span class="external-arrow" aria-hidden="true"><Icon name="arrowUpRight" /></span></div></div></div></section>

  <section class="home-section product-section" id="product"><div class="site-container"><div class="section-intro centered"><span class="micro-label">{c.productEyebrow}</span><h2>{c.productTitle}</h2><p>{c.productText}</p></div>
    <div class="product-viewer" data-tabs>
      <div class="product-tabs" role="tablist" aria-label={c.productTitle}>{c.productTabs.map((title,i) => <button id={`product-tab-${i}`} type="button" role="tab" aria-selected={i===0 ? 'true' : 'false'} aria-controls={`product-panel-${i}`} tabindex={i===0 ? 0 : -1} data-tab={i}><span>0{i+1}</span>{title}</button>)}</div>
      {screenshots.map((src,i) => <div id={`product-panel-${i}`} role="tabpanel" aria-labelledby={`product-tab-${i}`} tabindex="0" hidden={i!==0} data-panel={i}><div class="viewer-toolbar"><div aria-hidden="true"><i></i><i></i><i></i></div><span>1flowbase / {['workflow','execution','api'][i]}</span><span>{c.screenshotNote}</span></div><div class="product-image-wrap"><Image src={src} alt={c.productCaptions[i]} widths={[640,960,1440,2034]} sizes="(max-width: 1200px) 94vw, 1160px" loading="lazy" class="product-image" /></div><p class="image-caption">{c.productCaptions[i]}</p></div>)}
    </div>
  </div></section>

  <section class="home-section agent-section"><div class="site-container agent-grid"><div class="section-intro"><span class="micro-label"><span class="status-dot"></span>{c.agentsEyebrow}</span><h2 class="preserve-lines">{c.agentsTitle}</h2><p>{c.agentsText}</p><a class="text-link" href={localePath(lang,'/docs/')}>{lang==='zh'?'探索文档':'Explore the docs'}<Icon name="arrow"/></a></div><div><div class="agent-tools">{c.agentsSteps.map(([command,description],i) => <div><span class="tool-number">0{i+1}</span><code>{command}<span>()</span></code><p>{description}</p><span class="external-arrow" aria-hidden="true"><Icon name="arrowUpRight" /></span></div>)}</div><div class="roadmap-note"><span class="roadmap-marker"></span><div><strong>{c.agentsStatusTitle}</strong><p>{c.agentsStatus}</p></div></div></div></div></section>

  <section class="home-section audience-section"><div class="site-container"><div class="section-intro"><span class="micro-label">{c.audienceEyebrow}</span><h2>{c.audienceTitle}</h2></div><div class="audience-grid">{c.audiences.map(([num,title,text]) => <article><span>{num}</span><h3>{title}</h3><p>{text}</p></article>)}</div><a class="text-link" href={localePath(lang,'/use-cases/')}>{lang==='zh'?'找到你的使用场景':'Find your use case'}<Icon name="arrow"/></a></div></section>

  <HomeGuides lang={lang} />

  <section class="home-section install-section" id="get-started"><div class="site-container install-grid"><div class="section-intro"><span class="micro-label">{c.installEyebrow}</span><h2 class="preserve-lines">{c.installTitle}</h2><p>{c.installText}</p><a class="text-link" href={localePath(lang,'/docs/')}>{c.installLink}<Icon name="arrow"/></a></div><div class="install-card" data-tabs><div class="install-tabs" role="tablist" aria-label={lang==='zh'?'选择操作系统':'Choose operating system'}>{commands.map((item,i) => <button type="button" id={`install-tab-${i}`} role="tab" aria-selected={i===0?'true':'false'} aria-controls={`install-panel-${i}`} tabindex={i===0?0:-1} data-tab={i}>{item.name}</button>)}</div>{commands.map((item,i) => <div hidden={i!==0} id={`install-panel-${i}`} role="tabpanel" aria-labelledby={`install-tab-${i}`} data-panel={i}><div class="command-topline"><span>{item.label}</span><button type="button" class="copy-command" data-copy-command={item.command} data-copy-label={c.copy} data-copied-label={c.copied} data-copy-error={c.copyError}>{c.copy}<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 8h12v12H8zM16 8V4H4v12h4"/></svg></button></div><pre><code>{item.command}</code></pre><a class="script-link" href={item.url}>{c.reviewScript}<span class="external-arrow" aria-hidden="true"><Icon name="arrowUpRight" /></span></a></div>)}<p class="install-note">{c.installNote}</p><p class="copy-status" role="status" aria-live="polite"></p></div></div></section>

  <section class="home-section faq-section" id="faq"><div class="site-container faq-grid"><div class="section-intro"><span class="micro-label">{c.faqEyebrow}</span><h2>{c.faqTitle}</h2></div><div>{c.faqs.map(([q,a]) => <details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></div></section>
  <section class="closing-section"><div class="site-container"><div><h2>{c.finalTitle}</h2><p>{c.finalText}</p></div><a class="button-primary" href="#get-started">{c.finalCta}<Icon name="arrow"/></a></div></section>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach(root => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
    const select = (index: number, focus = false) => {
      tabs.forEach((tab,i) => { tab.setAttribute('aria-selected',String(i===index)); tab.tabIndex = i===index ? 0 : -1; });
      panels.forEach((panel,i) => { panel.hidden = i!==index; });
      if (focus) tabs[index]?.focus();
    };
    tabs.forEach((tab,i) => {
      tab.addEventListener('click',() => select(i));
      tab.addEventListener('keydown',event => {
        let next = i;
        if (event.key === 'ArrowRight') next = (i+1)%tabs.length;
        else if (event.key === 'ArrowLeft') next = (i-1+tabs.length)%tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length-1;
        else return;
        event.preventDefault(); select(next,true);
      });
    });
  });
  document.querySelectorAll<HTMLButtonElement>('[data-copy-command]').forEach(button => {
    let timer: ReturnType<typeof setTimeout>;
    button.addEventListener('click',async () => {
      const status = button.closest('.install-card')?.querySelector('.copy-status');
      try {
        await navigator.clipboard.writeText(button.dataset.copyCommand ?? '');
        if(status) status.textContent = button.dataset.copiedLabel ?? 'Copied';
        clearTimeout(timer); timer = setTimeout(() => { if(status) status.textContent = ''; },3500);
      } catch { if(status) status.textContent = button.dataset.copyError ?? 'Select the command to copy it manually.'; }
    });
  });
</script>

<style>
  .hero-stack{display:flex;flex-direction:column;gap:43px;padding-top:55px;padding-bottom:48px}
  .hero-stack .hero-message{width:100%;max-width:980px;text-align:center}
  .hero-stack .hero-message h1{font-size:clamp(43px,4.7vw,64px);line-height:1.15;margin:19px 0 22px;letter-spacing:-.055em}
  .hero-stack .hero-message h1 span{display:inline;margin-right:.14em}.hero-stack .hero-message h1 .accent-line{display:block;margin-right:0}
  .hero-stack .hero-lead{max-width:690px;margin:0 auto 24px}.hero-stack .hero-actions,.hero-stack .trust-list{justify-content:center}.hero-stack .trust-list{margin-top:22px}
  @media(max-width:780px){.hero-stack{gap:33px;padding-top:36px;padding-bottom:35px}.hero-stack .hero-message{max-width:620px}.hero-stack .hero-message h1{font-size:clamp(37px,6.8vw,52px)}.hero-stack .hero-lead{max-width:540px}}
  @media(max-width:480px){.hero-stack .hero-message h1{font-size:38px}.hero-stack .hero-message h1 span{display:block;margin:0}.hero-stack .hero-actions{flex-wrap:wrap}.hero-stack .hero-lead{font-size:14px}}

  .architecture-section{padding:66px 0;background:#fff;border-bottom:1px solid #e2e8dd}
  .architecture-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:27px}
  .architecture-heading h2{font-size:clamp(28px,3vw,38px);font-weight:540;letter-spacing:-.045em;line-height:1.2;margin:12px 0 0}
  .architecture-heading p{font-size:12px;line-height:1.7;color:#71816c;max-width:280px;margin:0}
  .architecture-section :global(.hero-flow-widget){max-width:none;width:100%}
  .architecture-section :global(.hero-flow){padding:26px}
  @media(max-width:780px){.architecture-heading{display:block}.architecture-heading p{margin-top:14px}.architecture-section{padding:46px 0}.architecture-section :global(.hero-flow){padding:20px 16px}}
  @media(max-width:480px){.architecture-section :global(.hero-flow){padding:16px 12px}}
</style>

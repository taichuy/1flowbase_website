---
import type { Locale } from '../config';
import { homeCopy } from '../data/home';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const zh = lang === 'zh';
const c = homeCopy[lang];
const s = c.sections;

const agents = [
  ['Claude Code', '#d97757', 'C'],
  ['Codex', '#3b82f6', '◎'],
  ['DeepSeek Harness', '#2563eb', 'D'],
  ['Gemini CLI', '#0ea5e9', '✦'],
  ['OpenCode', '#111827', '▣'],
  ['Cursor', '#0f172a', '⌘'],
  [zh ? '微信私聊通讯' : 'WeChat IM', '#07c160', '微'],
  ['WebMCP / MCP', '#059669', 'M'],
];

const models = [
  ['DeepSeek', '#2563eb'],
  ['Claude', '#d97757'],
  ['OpenAI', '#10a37f'],
  ['Gemini', '#0284c7'],
  ['Qwen', '#6366f1'],
  ['GLM', '#0ea5e9'],
  ['Kimi', '#111827'],
  ['OpenRouter', '#4f46e5'],
  ['Ollama', '#334155'],
];

const collectors = [
  {
    name: 'Claude Code',
    ver: 'v0.1.1',
    tone: 'claude',
    glyph: '✳',
    desc: zh ? 'Claude Code 生命周期会话采集包' : 'Native Claude Code lifecycle collector',
    action: zh ? '下载采集 CLI' : 'Download CLI',
    ready: true,
  },
  {
    name: 'Codex',
    ver: 'v0.4.1',
    tone: 'openai',
    glyph: '◎',
    desc: zh ? 'Codex 原生客户端三级日志采集器' : 'Native Codex 3-tier trajectory collector',
    action: zh ? '下载采集 CLI' : 'Download CLI',
    ready: true,
  },
  {
    name: 'DeepSeek Harness',
    ver: 'v0.1.1',
    tone: 'deepseek',
    glyph: 'D',
    desc: zh ? 'DSH Cordis 运行轨迹同步采集器' : 'DeepSeek Harness Cordis collector',
    action: zh ? '安装到 1flowbase' : 'Install Package',
    ready: false,
  },
  {
    name: 'OpenCode',
    ver: 'v0.1.1',
    tone: 'dark',
    glyph: '▣',
    desc: zh ? 'OpenCode 本地会话无侵入归档包' : 'Native OpenCode session collector',
    action: zh ? '安装到 1flowbase' : 'Install Package',
    ready: false,
  },
];

const ghRows = [
  { rank: '👑 1', name: 'NVIDIA/auto-ontology', desc: zh ? 'NVIDIA 开源的可解释语义图谱与 Agent 数据推理框架' : 'Explainable semantic graph & Agent data reasoning framework', gain: '+2,053', stars: '4.9k', forks: '394', tone: 'row-coral' },
  { rank: '👑 2', name: 'max-sixty/worktrunk', desc: zh ? '服务多 Agent 并行编码的 Git worktree 工作流 CLI' : 'Git worktree workflow CLI for parallel multi-agent coding', gain: '+524', stars: '11.0k', forks: '411', tone: 'row-sky' },
  { rank: '👑 3', name: 'mattpocock/skills', desc: zh ? '面向真实工程任务的可复用 Agent Skills 集合' : 'Reusable Agent Skills for real software engineering workflows', gain: '+1,376', stars: '313.3k', forks: '26.2k', tone: 'row-mint' },
  { rank: '4', name: 'floci-io/floci', desc: zh ? '免费开源的本地云服务模拟器与测试沙箱' : 'Open-source local cloud service emulator and sandbox', gain: '+1,082', stars: '29.6k', forks: '3,274', tone: 'row-amber' },
  { rank: '5', name: 'thedotmack/claude-mem', desc: zh ? '跨会话 Agent 持久记忆与上下文压缩引擎' : 'Cross-session persistent Agent memory & context compression', gain: '+1,165', stars: '112.8k', forks: '9,799', tone: 'row-lavender' },
];

const mcpSteps = zh
  ? [
      {
        tab: '01 mcp_list · 渐进发现',
        folder: 'build_api',
        badge: '节省 >94% 初始上下文',
        req: 'mcp_list({ path: "/" })',
        res: `// 仅返回顶层模块目录摘要，不一次性塞入 287 个工具 Schema
[
  { "path": "/frontstage_ui", "tools": 24, "desc": "创建与修改原生 React TSX 页面与菜单" },
  { "path": "/build_api",     "tools": 31, "desc": "数据建模建物理表生成 CRUD API 与工作流" },
  { "path": "/ai_chat_logs",  "tools": 18, "desc": "先统计，再检索对话，按需读取详细日志" },
  { "path": "/settings",      "tools": 42, "desc": "模型供应商、角色接口权限与额度配置" }
]`,
      },
      {
        tab: '02 mcp_get · 按需读定义',
        folder: 'build_api',
        badge: '单工具精准拉取 Schema',
        req: 'mcp_get({ tool_id: "data_model.create_table" })',
        res: `// 确定目标工具后，才拉取这 1 个接口的精确参数契约
{
  "tool_id": "data_model.create_table",
  "method": "POST /api/console/data-sources/primary/tables",
  "input_schema": {
    "code": "string (全局唯一物理表名)",
    "template": "general | ordered_tree | file_table",
    "open_api": "boolean (默认自动开放 CRUD 接口)"
  }
}`,
      },
      {
        tab: '03 mcp_call · 执行操作',
        folder: 'frontstage_ui',
        badge: 'RBAC 同源权限校验',
        req: 'mcp_call({ tool_id: "data_model.create_table", arguments: { code: "biaoshu_rules", template: "general", open_api: true } })',
        res: `// 直接在 PostgreSQL 同步创建物理表并注册 OpenAPI 路由
{
  "status": "succeeded",
  "physical_table": "public.biaoshu_rules",
  "generated_endpoints": [
    "GET    /api/biaoshu_rules",
    "POST   /api/biaoshu_rules",
    "PATCH  /api/biaoshu_rules/:id"
  ]
}`,
      },
      {
        tab: '04 mcp_result · 分页提取',
        folder: 'ai_chat_logs',
        badge: '防大返回值撑爆窗口',
        req: 'mcp_result({ call_id: "call_9f2a81", page: 1, page_size: 20 })',
        res: `// 当查询日志或文档结果过大时，自动游标分页读取，绝不撑爆模型上下文
{
  "call_id": "call_9f2a81",
  "page": 1,
  "total_pages": 6,
  "has_more": true,
  "next_cursor": "cur_p2_offset_20",
  "items_preview": "[20 条精选会话摘要已安全载入...]"
}`,
      },
    ]
  : [
      {
        tab: '01 mcp_list · Discover',
        folder: 'build_api',
        badge: 'Saves >94% prompt tokens',
        req: 'mcp_list({ path: "/" })',
        res: `// Returns lightweight directory groups instead of dumping 287 schemas
[
  { "path": "/frontstage_ui", "tools": 24, "desc": "Create & update Native React TSX pages & menus" },
  { "path": "/build_api",     "tools": 31, "desc": "Sync physical Postgres tables & workflows" },
  { "path": "/ai_chat_logs",  "tools": 18, "desc": "Aggregate stats, search chats & read traces" },
  { "path": "/settings",      "tools": 42, "desc": "Providers, endpoint RBAC & credit quotas" }
]`,
      },
      {
        tab: '02 mcp_get · Read Schema',
        folder: 'build_api',
        badge: 'Single-tool schema fetch',
        req: 'mcp_get({ tool_id: "data_model.create_table" })',
        res: `// Fetches the parameter contract ONLY for the selected endpoint
{
  "tool_id": "data_model.create_table",
  "method": "POST /api/console/data-sources/primary/tables",
  "input_schema": {
    "code": "string (unique physical table name)",
    "template": "general | ordered_tree | file_table",
    "open_api": "boolean (auto-expose CRUD endpoints)"
  }
}`,
      },
      {
        tab: '03 mcp_call · Execute',
        folder: 'frontstage_ui',
        badge: 'RBAC permission checked',
        req: 'mcp_call({ tool_id: "data_model.create_table", arguments: { code: "bid_audit_rules", template: "general", open_api: true } })',
        res: `// Syncs physical PostgreSQL table and registers live OpenAPI routes
{
  "status": "succeeded",
  "physical_table": "public.bid_audit_rules",
  "generated_endpoints": [
    "GET    /api/bid_audit_rules",
    "POST   /api/bid_audit_rules",
    "PATCH  /api/bid_audit_rules/:id"
  ]
}`,
      },
      {
        tab: '04 mcp_result · Paginate',
        folder: 'ai_chat_logs',
        badge: 'Zero context overflow',
        req: 'mcp_result({ call_id: "call_9f2a81", page: 1, page_size: 20 })',
        res: `// Large query payloads are cursor-paginated so context windows stay clean
{
  "call_id": "call_9f2a81",
  "page": 1,
  "total_pages": 6,
  "has_more": true,
  "next_cursor": "cur_p2_offset_20",
  "items_preview": "[20 summarized records safely loaded...]"
}`,
      },
    ];
---

<!-- 0. ECOSYSTEM COMPATIBILITY ICON STRIP -->
<section class="brand-strip-section">
  <div class="site-container">
    <p class="strip-label">{c.agentStripTitle}</p>
    <div class="brand-chip-row">
      {agents.map(([name, color, glyph]) => (
        <span class="brand-chip">
          <i style={`background:${color}`}>{glyph}</i>
          {name}
        </span>
      ))}
    </div>

    <p class="strip-label mt-strip">{c.modelStripTitle}</p>
    <div class="brand-chip-row">
      {models.map(([name, color]) => (
        <span class="brand-chip subtle">
          <b class="model-dot" style={`background:${color}`}></b>
          {name}
        </span>
      ))}
    </div>
  </div>
</section>

<!-- =======================================================================
     MODULE 1: TRAJECTORY MEMORY & AGENT-LOGS CLI (c241d90e...png + ddef19...jpeg)
     ======================================================================= -->
<section class="vis-section bg-white" id="capabilities">
  <div class="site-container">
    <div class="vis-intro">
      <span class="vis-eyebrow">{s.memory.eyebrow}</span>
      <h2>{s.memory.title}</h2>
      <p>{s.memory.desc}</p>
    </div>

    <!-- Top: Authentic 采集 CLI 4-Card Strip (from c241d90e...-9.png) -->
    <div class="collector-strip-card">
      <div class="cs-head">
        <div>
          <strong>⌘ {zh ? '采集 CLI · 端侧无侵入同步包' : 'Collector CLI · Local Agent Sync Packages'}</strong>
          <span>{zh ? '先将采集器安装到 1flowbase，再下载对应 CLI 上传客户端对话日志' : 'Install collector packages and upload local coding agent trajectories'}</span>
        </div>
        <b class="saved-pill">agent-logs</b>
      </div>

      <div class="collector-grid">
        {collectors.map((col) => (
          <div class="col-pkg-card">
            <div class="cp-top">
              <span class:list={['cp-ico', `tone-${col.tone}`]}>{col.glyph}</span>
              <div>
                <strong>{col.name}</strong>
                <small>{col.ver}</small>
              </div>
              <em class:list={['cp-state', col.ready && 'ready']}>
                {col.ready ? (zh ? '平台已安装' : 'Installed') : (zh ? '可一键安装' : 'Available')}
              </em>
            </div>
            <p>{col.desc}</p>
            <span class:list={['cp-btn', col.ready && 'primary']}>{col.action}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Main: Pixel Replica of AI chat history · 总轨迹 (ddef19b6d...jpeg) -->
    <div class="ui-replica trace-replica">
      <div class="trace-head">
        <div class="trace-title-row">
          <strong>{zh ? '总轨迹 · AI chat history' : 'Execution Trajectory · AI chat history'}</strong>
          <div class="trace-seg">
            <span class="active">{zh ? '客户端请求' : 'Client Requests'}</span>
            <span>{zh ? '工作流内部事件' : 'Workflow Events'}</span>
          </div>
          <span class="trace-search">🔍 {zh ? '搜索已加载步骤' : 'Search trace steps'}</span>
        </div>

        <div class="trace-gantt">
          <div class="gantt-row">
            <span>{zh ? '输入' : 'Input'}</span>
            <div class="gantt-track"><i class="bar-gray" style="left:2%;width:9%"></i></div>
          </div>
          <div class="gantt-row">
            <span>{zh ? '模型' : 'Model'}</span>
            <div class="gantt-track"><i class="bar-purple" style="left:12%;width:22%"></i><i class="bar-purple" style="left:68%;width:16%"></i></div>
          </div>
          <div class="gantt-row">
            <span>{zh ? '工具' : 'Tools'}</span>
            <div class="gantt-track"><i class="bar-orange" style="left:35%;width:31%"></i><i class="bar-orange" style="left:85%;width:9%"></i></div>
          </div>
        </div>

        <div class="trace-chips">
          <span class="chip-on">{zh ? '全部' : 'All'}</span>
          <span>{zh ? '助手消息 2' : 'Assistant 2'}</span>
          <span>{zh ? '推理 2' : 'Reasoning 2'}</span>
          <span>{zh ? '系统提示词 3' : 'System 3'}</span>
          <span>{zh ? '工具调用 4' : 'Tool Calls 4'}</span>
          <span>{zh ? '工具定义 14' : 'Tool Defs 14'}</span>
          <span class="trace-meta">reasoning.effort=high · stream=true</span>
        </div>
      </div>

      <div class="trace-list">
        <div class="trace-item">
          <span class="t-badge orange">{zh ? '工具调用' : 'Tool Call'}</span>
          <code>mcp_list(path="/ai_chat_logs")</code>
          <em>{zh ? '检索团队近 24h 会话统计与提交回执' : 'Query 24h team session summaries & commits'}</em>
          <b>#13</b>
        </div>
        <div class="trace-item">
          <span class="t-badge purple">{zh ? '模型推理' : 'Reasoning'}</span>
          <code>deepseek/deepseek-v4-pro</code>
          <em>{zh ? '交叉核对约 200 条运行记录摘要与 GitHub Issue' : 'Cross-check 200 run traces with GitHub issues'}</em>
          <b>#21</b>
        </div>
        <div class="trace-item">
          <span class="t-badge emerald">{zh ? '自动产出' : 'Artifact'}</span>
          <code>daily_reports.insert()</code>
          <em>{zh ? '已生成《工作日报｜文件表与 SSH/MCP 双向传输》' : 'Generated structured Daily Engineering Report'}</em>
          <b>#34</b>
        </div>
      </div>
    </div>

    <div class="compact-3grid">
      {s.memory.cards.map(([title, body]) => (
        <div class="c-cell">
          <h3>{title}</h3>
          <p>{body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- =======================================================================
     MODULE 2: BACKEND EXTENSION — WORKFLOWS, EVENT CENTER & WECHAT IM
     (Merges Event Hooks + API Extension Nodes + WeChat /paipan Slash Trigger)
     ======================================================================= -->
<section class="vis-section bg-mint">
  <div class="site-container">
    <div class="vis-intro">
      <span class="vis-eyebrow">{s.superagent.eyebrow}</span>
      <h2>{s.superagent.title}</h2>
      <p>{s.superagent.desc}</p>
    </div>

    <div class="event-router-pair">
      <!-- Left: Switchable Event Center & Workflow API Extension Replica -->
      <div class="ui-replica backend-ext-card" data-tabs>
        <div class="replica-bar">
          <div class="ext-tab-pills" role="tablist" aria-label={zh ? '切换事件中心与工作流扩展' : 'Switch Event Center & Workflow'}>
            <button type="button" role="tab" aria-selected="true" tabindex="0" data-tab="0">
              {zh ? '事件中心 · 请求前后钩子' : 'Event Center · Hooks'}
            </button>
            <button type="button" role="tab" aria-selected="false" tabindex="-1" data-tab="1">
              {zh ? '工作流 · 接口扩展与节点' : 'Workflow · API & Nodes'}
            </button>
          </div>
          <span class="btn-mint-sm">{zh ? '无需重启' : 'Hot Reload'}</span>
        </div>

        <!-- Panel 0: Event Center Catalog (103935299.png) -->
        <div class="ev-rows" data-panel="0">
          <div class="ev-row ev-head">
            <span>{zh ? '订阅事件名称' : 'Subscribed Event'}</span>
            <span>{zh ? '捕捉时机' : 'Hook Timing'}</span>
            <span>{zh ? '启用' : 'Active'}</span>
          </div>
          <div class="ev-row">
            <div>
              <strong class="teal-text">{zh ? '标书上传完成后自动逐页解析' : 'biaoshu.file.uploaded.after'}</strong>
              <small>{zh ? '文件表响应完成后 · 送入 MinerU 提取页码与文本' : 'Post-upload hook · parse pages via MinerU'}</small>
            </div>
            <span class="ev-tag">{zh ? '响应后拦截' : 'After API'}</span>
            <span class="ui-switch on" aria-hidden="true"><i></i></span>
          </div>
          <div class="ev-row">
            <div>
              <strong class="teal-text">{zh ? '紫微/八字排盘请求（微信指令）' : 'communication.command.paipan'}</strong>
              <small>communication_commands · {zh ? '自定义聊天事件触发工作流' : 'WeChat slash command event'}</small>
            </div>
            <span class="ev-tag">{zh ? '指令订阅' : 'IM Event'}</span>
            <span class="ui-switch on" aria-hidden="true"><i></i></span>
          </div>
          <div class="ev-row">
            <div>
              <strong class="teal-text">{zh ? '敏感删除接口前置合规校验' : 'table.record.delete.before'}</strong>
              <small>{zh ? '接口请求执行前 · 校验审批状态与备份留痕' : 'Pre-request hook · audit & guard'}</small>
            </div>
            <span class="ev-tag">{zh ? '请求前拦截' : 'Before API'}</span>
            <span class="ui-switch on" aria-hidden="true"><i></i></span>
          </div>
          <div class="ev-row">
            <div>
              <strong class="teal-text">{zh ? '00:10 每日工作报告与日榜更新' : 'cron.daily.engineering_report'}</strong>
              <small>scheduled_tasks · {zh ? '定时聚合会话日志与仓库动态' : 'Scheduled workflow job'}</small>
            </div>
            <span class="ev-tag">Cron</span>
            <span class="ui-switch on" aria-hidden="true"><i></i></span>
          </div>
        </div>

        <!-- Panel 1: Workflow API Extension & Built-in Nodes (104505119.png + 104723919.png) -->
        <div class="wf-ext-panel" data-panel="1" hidden>
          <div class="wf-api-box">
            <div class="wab-top">
              <span class="method-pill">POST</span>
              <code>/api/ex/biaoshu/check</code>
              <b class="sync-tag">{zh ? '接口扩展 · 同步响应' : 'API Extension · Sync'}</b>
            </div>
            <p>{zh ? '自定义入参与响应结构，不重启后端直接发布新业务 API。' : 'Custom request/response schema published dynamically as a REST endpoint.'}</p>
          </div>

          <div class="wf-nodes-label">{zh ? '内置确定性与大模型编排节点' : 'Built-in Deterministic & LLM Nodes'}</div>
          <div class="wf-nodes-grid">
            <div class="wfn-chip"><b>W</b><span>Workflow Start / End</span></div>
            <div class="wfn-chip"><b>🗄</b><span>Data Model CRUD</span></div>
            <div class="wfn-chip"><b>⇆</b><span>If / Else {zh ? '条件判断' : 'Branch'}</span></div>
            <div class="wfn-chip"><b>↻</b><span>Iteration / Loop {zh ? '循环' : ''}</span></div>
            <div class="wfn-chip"><b>&lt;/&gt;</b><span>JS Code &amp; SQL {zh ? '脚本' : ''}</span></div>
            <div class="wfn-chip"><b>⚡</b><span>LLM &amp; HTTP {zh ? '调用' : 'Call'}</span></div>
          </div>
        </div>
      </div>

      <!-- Right: WeChat Communication Hub + /paipan Live Chat Replica (105330486 + 112003026) -->
      <div class="ui-replica wechat-card">
        <div class="replica-bar">
          <div class="wx-status">
            <span class="wx-dot"></span>
            <strong>{zh ? '通讯中心 · 微信私聊与自定义指令' : 'Communication Hub · WeChat Slash Commands'}</strong>
          </div>
          <span class="saved-pill">{zh ? '已连接微信' : 'WeChat Live'}</span>
        </div>

        <div class="wx-cmd-strip">
          <span><code>/new</code> {zh ? '新会话' : 'Reset'}</span>
          <span><code>/model</code> {zh ? '切模型' : 'Model'}</span>
          <span class="active"><code>/paipan</code> {zh ? '触发排盘流' : 'Workflow'}</span>
          <span><code>/report</code> {zh ? '查日报' : 'Report'}</span>
        </div>

        <div class="wx-chat-window">
          <div class="wx-bubble-user">
            {zh
              ? '/paipan --birth=2026-11-11 --time=13:09 --gender=男 --city=湛江市'
              : '/report --date=2026-10-13 --workspace=1flowbase-gateway'}
          </div>

          <div class="wx-bubble-bot">
            <strong>{zh ? '【事件已唤醒工作流并返回精简结论】' : '[Workflow Triggered & Executed]'}</strong>
            <ul>
              {zh ? (
                <>
                  <li>• 出生地点：广东省 湛江市（110.36°E, 21.27°N）</li>
                  <li>• 真太阳时校准：2026-11-11 12:46:26（JS 节点精确换算）</li>
                  <li>• 完整排盘报告已写入数据表，可随时在网页端查看 ↗</li>
                </>
              ) : (
                <>
                  <li>• Aggregated 154 Codex runs &amp; ~200 gateway trace summaries</li>
                  <li>• Verified 3 completed issues (#2408) with commit hashes</li>
                  <li>• Saved to Daily Reports table—tap to open web view ↗</li>
                </>
              )}
            </ul>
          </div>
        </div>
      </div>
    </div>

    <div class="compact-3grid">
      {s.superagent.cards.map(([title, body]) => (
        <div class="c-cell">
          <h3>{title}</h3>
          <p>{body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- =======================================================================
     MODULE 3: PROGRESSIVE MCP ENGINE (4-Step Interactive Discovery & Pagination)
     ======================================================================= -->
<section class="vis-section bg-white">
  <div class="site-container">
    <div class="vis-intro">
      <span class="vis-eyebrow">{s.mcpChat.eyebrow}</span>
      <h2>{s.mcpChat.title}</h2>
      <p>{s.mcpChat.desc}</p>

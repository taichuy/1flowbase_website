---
import { SITE, type Locale } from '../config';
import { pageCopy, useCasesCopy } from '../data/copy';

interface Props { lang: Locale }
const { lang } = Astro.props;
const intro = pageCopy[lang].useCases;
const cases = useCasesCopy[lang];
---

<section class="dark-panel">
  <div class="site-container relative z-10 py-20 sm:py-28">
    <span class="eyebrow !text-emerald">{intro.eyebrow}</span>
    <h1 class="mt-5 max-w-5xl text-[clamp(3rem,7vw,6rem)] font-[760] leading-[0.95] tracking-[-0.068em] text-white">{intro.title}</h1>
    <p class="mt-7 max-w-2xl text-lg leading-8 text-white/62">{intro.description}</p>
  </div>
</section>

<section class="section-shell">
  <div class="site-container grid gap-7">
    {cases.map((item) => (
      <article class="glass-card overflow-hidden">
        <div class="grid lg:grid-cols-[0.9fr_1.1fr]">
          <div class="border-b border-line p-7 sm:p-10 lg:border-b-0 lg:border-r">
            <span class="font-mono text-xs font-black text-emerald">{item.index}</span>
            <h2 class="mt-10 text-3xl font-[760] leading-tight tracking-[-0.05em] text-ink sm:text-4xl">{item.title}</h2>
            <div class="mt-8 grid gap-6 text-sm leading-7 text-muted">
              <div><h3 class="mb-1 font-black text-ink">{lang === 'zh' ? '现有问题' : 'The limitation'}</h3><p>{item.problem}</p></div>
              <div><h3 class="mb-1 font-black text-ink">{lang === 'zh' ? '应用方案' : 'The approach'}</h3><p>{item.solution}</p></div>
            </div>
            {item.guide && <a class="mt-8 inline-flex text-sm font-black text-emerald hover:text-forest" href={`${SITE.wiki}/${item.guide}`}>{lang === 'zh' ? '查看工作流示例' : 'Explore a workflow example'} →</a>}
          </div>
          <div class="border-line bg-gradient-to-br from-[#effff8] via-white to-[#eef8ff] p-7 sm:p-10 lg:border-l">
            <div class="relative z-10 flex h-full min-h-[21rem] flex-col justify-center gap-3">
              {item.flow.map((step, index) => (
                <>
                <div class="rounded-xl border border-line bg-white/85 px-5 py-4 text-sm font-bold text-ink shadow-sm"><span class="mr-3 font-mono text-xs text-emerald">0{index + 1}</span>{step}</div>
                  {index < item.flow.length - 1 && <div class="pl-7 text-emerald/50">↓</div>}
                </>
              ))}
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
